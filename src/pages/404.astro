---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Mirror from '../components/Mirror.astro';
---
<Base title="404 · Omega ⟷ agemO" description="This page does not exist.">
  <Nav />

  <section class="lost" data-404>
    <div class="lost__hero">
      <Mirror word="404" ariaLabel="404" variant="small" />
    </div>
    <p class="lost__body">This page does not exist.</p>
    <a class="lost__back" href="/">← Back home</a>
  </section>
</Base>

<style>
  .lost {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 85svh;
    padding: var(--gutter);
    text-align: center;
    gap: 1.5rem;
  }

  .lost__hero {
    display: flex;
    justify-content: center;
  }

  .lost__body {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: var(--graphite);
    margin: 0;
  }

  .lost__back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--paper-2);
    transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }

  .lost__back:hover,
  .lost__back:focus-visible {
    border-color: var(--signal);
    color: var(--signal);
  }
</style>

<script>
  import { initMirrorLine } from '../scripts/mirror-line.js';
  initMirrorLine();
</script>
