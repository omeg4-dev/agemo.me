---
import Sub from '../layouts/Sub.astro';

// The shelf, as gamehub ships it.
const games = [
  { icon: '🎈', name: 'Balloon Rush', players: '1–4', body: 'Everyone pops at once. Combos, gold, and a bomb that costs you three.' },
  { icon: '💣', name: 'Hot Potato', players: '2–4', body: 'The bomb buzzes in your hand, and only you know how close it is.' },
  { icon: '🏓', name: 'Rebound', players: '1–4', body: 'One edge each. Hold the phone like a bat, press A to smash, lose a heart when it gets past.' },
  { icon: '🟢', name: 'Standoff', players: '1–4', body: 'Wait for green, then slam the screen. Twitch early and you sit the round out.' },
  { icon: '🟦', name: 'Dash', players: '1–4', body: 'Flick a direction and go until something stops you. Spikes, dots, and water rising behind you.' },
  { icon: '🌤️', name: 'Climb', players: '1–4', body: 'You bounce whether you like it or not. Tilt to lean, take the springs, never look down.' },
  { icon: '🔢', name: 'Merge', players: '1–4', body: 'Slide the whole board; equal tiles fuse. Two boards get the same tiles, so it’s a race.' },
  { icon: '🧩', name: 'Jigsaw', players: '1–4', body: 'A picture cut up and scattered. Everyone works on the same one, and the clock is the score.' },
  { icon: '🔎', name: 'Word Hunt', players: '1–4', body: 'Words hidden in a block of letters. Point at one end, press A, point at the other.' },
  { icon: '🐍', name: 'Snake', players: '1', body: 'Steer with a flick of the wrist. Holding the phone tilted does nothing: a flick is a rate.' },
  { icon: '🧪', name: 'Colour Sort', players: '1', body: 'Every board is dealt by undoing legal pours from a solved one, so every board can be solved.' },
  { icon: '❌', name: 'Tic Tac Toe', players: '1–2', body: 'Point at a square. On your own, the hub searches every cell and never loses.' },
  { icon: '🔵', name: 'Connect Four', players: '1–2', body: 'Slide, drop, and watch the step you just built for the other player.' },
];

const bubbles = [
  [8, 70, 90, 0], [18, 30, 46, 3], [80, 22, 120, 1], [90, 64, 60, 5], [62, 80, 34, 2], [40, 12, 28, 4], [30, 88, 70, 6],
];
---
<Sub
  title="gamehub · agemo.me"
  description="gamehub: party games on the TV, with everyone’s phone as the remote. Plus mc-jukebox, a Minecraft jukebox for the desktop bar."
  theme="#34beed"
  fonts={['nunito']}
  bodyClass="aero"
>
  <div class="aero-sky" aria-hidden="true">
    {bubbles.map(([x, y, s, d]) => <span class="bubble" style={`--x:${x}%;--y:${y}%;--s:${s}px;--d:${d}s`}></span>)}
    <span class="hill hill--back"></span>
    <span class="hill hill--front"></span>
  </div>

  <main id="main" class="aero-main">
    <section class="intro" aria-labelledby="gh-title">
      <p class="pill">gamehub</p>
      <h1 id="gh-title">The TV is the screen.<br />Everyone’s phone is the remote.</h1>
      <p class="lede">A living-room console made of a television, a laptop and whatever phones are in the room. No app, no pairing: scan the code and play.</p>
      <div class="tv">
        <video src="/media/gamehub.mp4" poster="/media/gamehub.webp" autoplay muted loop playsinline preload="none" width="960" height="518" aria-label="Two phones pointing at the hub’s game shelf, then playing Balloon Rush"></video>
      </div>
    </section>

    <section class="glass steps" aria-labelledby="join-title">
      <h2 id="join-title">Joining takes three steps</h2>
      <ol>
        <li><strong>Scan</strong> the QR code in the corner of the TV with the phone camera.</li>
        <li><strong>Accept</strong> the certificate once. It’s the hub’s own, on your own network.</li>
        <li><strong>Point.</strong> You get a cursor, a d-pad, A and B, and a buzz when something hits you.</li>
      </ol>
      <p class="note">Up to four players, each with their own colour and name. Put your phone down, pick it back up, and your slot is still yours.</p>
    </section>

    <section class="channels" aria-labelledby="ch-title">
      <h2 id="ch-title">On the shelf</h2>
      <ul class="grid">
        {games.map((g, i) => (
          <li>
            <button class="channel" type="button" data-game={i} aria-haspopup="dialog">
              <span class="channel__icon" aria-hidden="true">{g.icon}</span>
              <span class="channel__name">{g.name}</span>
              <span class="channel__players">{g.players} {g.players === '1' ? 'player' : 'players'}</span>
            </button>
          </li>
        ))}
      </ul>
      <p class="note center">Twelve more are planned. <a href="https://github.com/omeg4-dev/gamehub" rel="noopener">gamehub on GitHub</a></p>
    </section>

    <section class="glass jukebox" id="jukebox" aria-labelledby="jb-title">
      <div class="jukebox__text">
        <p class="pill pill--green">also in the living room</p>
        <h2 id="jb-title">mc-jukebox</h2>
        <p>A Minecraft jukebox that sits in the desktop bar and puffs note particles while music plays. Click it and a slab of ground opens with the disc in the slot.</p>
        <p>When the track changes, the old disc pops out and drifts away while the new one drops in with a squash. It’s drawn in Cairo at 194×98 and scaled up by whole pixels, so it never looks blurry.</p>
        <a class="wii-btn" href="https://github.com/omeg4-dev/mc-jukebox" rel="noopener">mc-jukebox on GitHub</a>
      </div>
      <div class="tv tv--small">
        <video src="/media/jukebox-live.mp4" poster="/media/jukebox-live.webp" autoplay muted loop playsinline preload="none" width="960" height="540" aria-label="The jukebox panel: pause, skip and shuffle, with the disc swapping"></video>
      </div>
    </section>
  </main>

  <dialog class="preview" data-preview aria-labelledby="pv-name">
    <form method="dialog">
      <span class="preview__icon" data-pv-icon aria-hidden="true"></span>
      <h2 id="pv-name" data-pv-name></h2>
      <p class="preview__players" data-pv-players></p>
      <p data-pv-body></p>
      <button class="wii-btn" value="close" autofocus>Back to the shelf</button>
    </form>
  </dialog>

  <footer class="wii-bar">
    <svg class="wii-bar__curve" viewBox="0 0 1440 32" preserveAspectRatio="none" aria-hidden="true"><path class="fill" d="M0 34 V24 C360 24 420 2 720 2 S1080 24 1440 24 V34 Z" /><path class="edge" d="M0 24 C360 24 420 2 720 2 S1080 24 1440 24" /></svg>
    <a class="round" href="/" aria-label="Back to agemo.me">Ω</a>
    <div class="clock" aria-hidden="true"><span data-time>12:00</span><small data-date>—</small></div>
    <a class="round" href="https://github.com/omeg4-dev/gamehub" rel="noopener" aria-label="gamehub on GitHub">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
    </a>
  </footer>

  <script is:inline type="application/json" id="games-data" set:html={JSON.stringify(games)}></script>
</Sub>

<style is:global>
  @font-face {
    font-family: 'Nunito';
    src: url('/fonts/nunito.woff2') format('woff2');
    font-weight: 400 900;
    font-display: swap;
  }

  body.aero {
    --blue: #34beed;
    --blue-deep: #0b7fb3;
    --ink: #33404d;
    --soft: #5b6b7a;
    --wii: #d7dce2;
    margin: 0;
    min-height: 100vh;
    background: linear-gradient(#4fb8f0 0%, #8fd4f7 38%, #d6f0fc 72%, #effaff 100%) fixed;
    color: var(--ink);
    font: 500 1.0625rem/1.55 'Nunito', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
    padding-bottom: 120px;
  }
  .aero *, .aero *::before, .aero *::after { box-sizing: border-box; }
  .aero :focus-visible { outline: 3px solid var(--blue-deep); outline-offset: 3px; border-radius: 12px; }
  .aero .skip { position: absolute; left: 16px; top: -100px; z-index: 100; padding: 10px 14px; background: #fff; color: var(--ink); border-radius: 999px; }
  .aero .skip:focus { top: 12px; }

  /* Sky, bubbles and hills sit behind everything. */
  .aero-sky { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .bubble {
    position: absolute;
    left: var(--x); top: var(--y);
    width: var(--s); height: var(--s);
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 26%, rgb(255 255 255 / 0.95) 0 9%, transparent 22%),
      radial-gradient(circle at 50% 50%, transparent 55%, rgb(255 255 255 / 0.55) 71%, rgb(120 200 255 / 0.35) 100%);
    box-shadow: inset 0 -6px 14px rgb(40 140 220 / 0.18);
    animation: float 14s ease-in-out var(--d) infinite alternate;
  }
  @keyframes float { to { transform: translateY(-38px) translateX(10px); } }
  .hill {
    position: absolute;
    left: -10%; right: -10%;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }
  .hill--back { bottom: -34vh; height: 58vh; background: linear-gradient(#8fdc5a, #4fae2e); transform: translateX(18%); opacity: 0.8; }
  .hill--front { bottom: -40vh; height: 56vh; background: linear-gradient(#7ad14a, #3f9a24); transform: translateX(-22%); }

  .aero-main { max-width: 1180px; margin: 0 auto; padding: 56px 16px 40px; }

  .pill {
    display: inline-block;
    margin: 0 0 18px;
    padding: 6px 18px;
    border-radius: 999px;
    background: linear-gradient(#ffffff, #dff3fd);
    border: 1px solid rgb(255 255 255 / 0.9);
    box-shadow: 0 2px 10px rgb(11 127 179 / 0.25), inset 0 -2px 0 rgb(11 127 179 / 0.12);
    color: var(--blue-deep);
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .pill--green { color: #2f7d18; }

  .intro { text-align: center; }
  .intro h1 {
    margin: 0 auto;
    max-width: 16ch;
    color: #fff;
    font-weight: 900;
    font-size: clamp(2.25rem, 1.2rem + 4.4vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 0 rgb(11 127 179 / 0.35), 0 8px 30px rgb(11 127 179 / 0.35);
  }
  .lede { max-width: 44ch; margin: 20px auto 36px; font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem); color: #134a66; }

  .tv {
    position: relative;
    margin: 0 auto;
    padding: clamp(8px, 1.4vw, 16px);
    max-width: 980px;
    border-radius: clamp(18px, 3vw, 34px);
    background: linear-gradient(#ffffff, #e3e9ef);
    box-shadow: 0 30px 60px -20px rgb(8 60 100 / 0.45), inset 0 1px 0 #fff, inset 0 -3px 0 rgb(0 0 0 / 0.06);
  }
  .tv video { display: block; width: 100%; height: auto; border-radius: clamp(10px, 2vw, 20px); background: #dfe7ee; }
  .tv::after {
    content: '';
    position: absolute;
    inset: clamp(8px, 1.4vw, 16px);
    border-radius: clamp(10px, 2vw, 20px);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.35), transparent 38%);
    pointer-events: none;
  }

  .glass {
    margin: clamp(48px, 7vw, 88px) auto 0;
    padding: clamp(22px, 3.4vw, 40px);
    border-radius: 28px;
    background: linear-gradient(rgb(255 255 255 / 0.78), rgb(255 255 255 / 0.55));
    border: 1px solid rgb(255 255 255 / 0.95);
    box-shadow: 0 20px 50px -24px rgb(8 60 100 / 0.5), inset 0 1px 0 #fff;
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
  }
  .glass h2, .channels h2 {
    margin: 0 0 16px;
    font-weight: 900;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    color: var(--blue-deep);
  }
  .steps ol { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .steps li {
    counter-increment: s;
    padding: 18px 18px 18px 64px;
    position: relative;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 2px 0 rgb(0 0 0 / 0.04);
  }
  .steps li::before {
    content: counter(s);
    position: absolute;
    left: 16px; top: 16px;
    width: 36px; height: 36px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: linear-gradient(#5fd0f7, #1a9fd6);
    color: #fff;
    font-weight: 900;
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.5);
  }
  .note { margin: 18px 0 0; color: var(--soft); }
  .note.center { text-align: center; }
  .note a { color: var(--blue-deep); font-weight: 800; }
  @media (max-width: 760px) { .steps ol { grid-template-columns: 1fr; } }

  /* Channel grid: white glossy tiles, like a console home screen. */
  .channels { margin-top: clamp(48px, 7vw, 88px); }
  .channels h2 { text-align: center; color: #fff; text-shadow: 0 2px 12px rgb(11 127 179 / 0.45); }
  .grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 200px), 1fr));
    gap: clamp(10px, 1.6vw, 18px);
  }
  .channel {
    width: 100%;
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 10px;
    border: 3px solid #fff;
    border-radius: 22px;
    background: linear-gradient(#ffffff 0%, #f1f5f8 60%, #e3eaf0 100%);
    box-shadow: 0 10px 22px -14px rgb(8 60 100 / 0.6), inset 0 -2px 0 rgb(0 0 0 / 0.05);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s, box-shadow 0.25s;
  }
  .channel:hover, .channel:focus-visible {
    transform: scale(1.05);
    border-color: var(--blue);
    box-shadow: 0 0 0 4px rgb(52 190 237 / 0.35), 0 16px 26px -14px rgb(8 60 100 / 0.6);
    outline: none;
  }
  .channel__icon { font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem); line-height: 1.1; }
  .channel__name { font-weight: 800; font-size: 1.0625rem; }
  .channel__players { color: var(--soft); font-size: 0.875rem; }

  .jukebox { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(20px, 3vw, 40px); align-items: center; }
  .jukebox__text h2 { margin-bottom: 10px; }
  .jukebox__text p { margin: 0 0 14px; }
  .tv--small { max-width: none; }
  @media (max-width: 860px) { .jukebox { grid-template-columns: 1fr; } }

  .wii-btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 6px;
    padding: 0 24px;
    border-radius: 999px;
    border: 2px solid var(--blue);
    background: linear-gradient(#ffffff, #e9f6fd);
    color: var(--blue-deep);
    font: 800 1rem 'Nunito', sans-serif;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 12px -6px rgb(11 127 179 / 0.6);
  }
  .wii-btn:hover { background: linear-gradient(#e9f6fd, #cdebfa); }

  .preview {
    width: min(92vw, 460px);
    padding: 32px 28px 28px;
    border: 3px solid #fff;
    border-radius: 30px;
    background: linear-gradient(#ffffff, #eaf1f6);
    color: var(--ink);
    text-align: center;
    box-shadow: 0 30px 80px -20px rgb(8 60 100 / 0.6);
  }
  .preview::backdrop { background: rgb(79 184 240 / 0.45); backdrop-filter: blur(6px); }
  .preview[open] { animation: pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes pop { from { transform: scale(0.85); opacity: 0; } }
  .preview__icon { display: block; font-size: 4rem; line-height: 1.1; }
  .preview h2 { margin: 8px 0 0; font-weight: 900; font-size: 2rem; color: var(--blue-deep); }
  .preview__players { margin: 0 0 12px; color: var(--soft); font-weight: 700; }

  /* The bar along the bottom: two round buttons and a clock. */
  .wii-bar {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px clamp(16px, 4vw, 48px) calc(env(safe-area-inset-bottom, 0px) + 12px);
    background: var(--wii);
  }
  .wii-bar__curve { position: absolute; left: 0; right: 0; top: -31px; width: 100%; height: 32px; }
  .wii-bar__curve .fill { fill: var(--wii); }
  .wii-bar__curve .edge { fill: none; stroke: #b9c1ca; stroke-width: 2; vector-effect: non-scaling-stroke; }
  .wii-bar .round { margin-top: -22px; }
  .round {
    position: relative;
    display: grid;
    place-items: center;
    width: 64px; height: 64px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 30%, #ffffff, #e5e9ed 70%);
    border: 3px solid #fff;
    box-shadow: 0 0 0 2px #b9c1ca, 0 6px 14px -6px rgb(0 0 0 / 0.35);
    color: #7b8794;
    font: italic 700 1.6rem Georgia, serif;
    text-decoration: none;
    transition: box-shadow 0.2s, color 0.2s;
  }
  .round:hover { color: var(--blue-deep); box-shadow: 0 0 0 3px var(--blue), 0 6px 14px -6px rgb(0 0 0 / 0.35); }
  .clock { position: relative; display: flex; flex-direction: column; align-items: center; color: #5f6a76; }
  .clock span { font-weight: 300; font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem); line-height: 1; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
  .clock small { font-weight: 800; font-size: 0.875rem; color: #454f5a; }

  @media (prefers-reduced-motion: reduce) {
    .bubble, .preview[open] { animation: none; }
    .channel { transition: none; }
  }
</style>

<script>
  import { initGames } from '../scripts/games.js';
  initGames();
</script>
