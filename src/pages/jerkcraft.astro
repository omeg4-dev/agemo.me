---
import Sub from '../layouts/Sub.astro';
import site from '../config/site.mjs';
import { pngDataUrl } from '../lib/png.mjs';

// Block textures, painted at build time: 16×16 pixels from a seeded random,
// so every build draws the same dirt and nothing is downloaded.
function rng(seed: number) {
  return () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 2 ** 32);
}
function texture(seed: number, pick: (x: number, y: number, r: number) => string) {
  const rand = rng(seed);
  const px: string[] = [];
  for (let i = 0; i < 256; i++) px.push(pick(i % 16, Math.floor(i / 16), rand()));
  return `url("${pngDataUrl(16, 16, (x, y) => px[y * 16 + x])}")`;
}
const DIRT = ['#79553a', '#6b4a32', '#8a6245', '#5d3f2a', '#966c4a'];
const dirtAt = (r: number) => DIRT[Math.floor(r * DIRT.length)];
const dirt = texture(7, (_x, _y, r) => dirtAt(r));
const grassDrip = [2, 3, 2, 4, 3, 2, 3, 5, 3, 2, 2, 4, 3, 3, 2, 4];
const GRASS = ['#5d9b37', '#6aab3f', '#4f8a2e', '#76b94a'];
const grass = texture(11, (x, y, r) => (y < grassDrip[x] ? GRASS[Math.floor(r * GRASS.length)] : dirtAt(r)));
const STONE = ['#7d7d7d', '#8a8a8a', '#6f6f6f', '#979797', '#747474'];
const stone = texture(23, (_x, _y, r) => STONE[Math.floor(r * STONE.length)]);

// Hotbar icons, drawn as pixel grids. One character per pixel.
const PAL: Record<string, string> = {
  g: '#6aab3f', G: '#4f8a2e', d: '#79553a', D: '#5d3f2a',
  s: '#dcdcdc', S: '#9a9a9a', w: '#8a6245', W: '#5d3f2a',
  y: '#f5d142', Y: '#c9a227', b: '#4d7fd6', B: '#2f5cab', k: '#2b2b2b',
};
function icon(rows: string[]) {
  let rects = '';
  rows.forEach((row, y) => [...row].forEach((c, x) => {
    if (PAL[c]) rects += `<rect x="${x}" y="${y}" width="1" height="1" fill="${PAL[c]}"/>`;
  }));
  return `<svg viewBox="0 0 10 10" shape-rendering="crispEdges" aria-hidden="true">${rects}</svg>`;
}
const icons = {
  top: icon(['gggggggggg', 'gGgggGgggg', 'gGggGGgGgg', 'ddGddGdGdd', 'dDdddddDdd', 'dddDdddddd', 'ddddddDddd', 'dDdddddddD', 'ddddDddddd', 'dddddddDdd']),
  features: icon(['........ss', '.......sSs', '......sSs.', '.....sSs..', '....sSs...', '.k.sSs....', '..kSs.....', '..wk......', '.wWkk.....', 'wW..k.....']),
  stats: icon(['..........', '.......yy.', '.......yY.', '....bb.yY.', '....bB.yY.', '.gg.bB.yY.', '.gG.bB.yY.', '.gG.bB.yY.', '.gG.bB.yY.', 'kkkkkkkkkk']),
  join: icon(['.wwwwwww..', '.wWWWWWw..', '.wW...Ww..', '.wW...Ww..', '.wWWWWWw..', '.wW...Ww..', '.wW..yWw..', '.wW...Ww..', '.wWWWWWw..', '.wwwwwww..']),
};

const skills = ['mining', 'farming', 'foraging', 'fighting', 'archery', 'fishing', 'excavation', 'defense', 'agility', 'enchanting', 'alchemy'];
const abilities = ['Treecapitator', 'Excavator', 'Speed Mine', 'Lightning Blade', 'Sharp Hook', 'Charged Shot', 'Replenish', 'Absorption'];

const features = [
  { title: 'Skills & mana', cmd: '11 skills', body: `Eleven skills level up as you play, and each has a mana ability that gets stronger every tier.` },
  { title: 'Auction house', cmd: '/ah', body: 'Sell to the whole server. Listings are searchable, and expired items come back to you.' },
  { title: 'Trading', cmd: '/trade', body: 'Trade face to face in a shared window. Both players confirm before anything moves, so nothing gets lost.' },
  { title: 'Homes', cmd: '/sethome', body: 'Set named homes in any dimension and warp back with /home.' },
  { title: 'Name tags', cmd: '/tag set', body: 'A short tag before your name, in the colour you pick. Shows in chat, the tab list and above your head.' },
  { title: 'Pearl chunkloaders', cmd: 'ender pearl', body: 'A thrown pearl keeps its chunk loaded, so long throws land even over unloaded terrain.' },
  { title: 'Bedrock crossplay', cmd: 'Geyser', body: 'Join from a phone, console or Windows Bedrock. You play in the same world as Java players.' },
];

const boards = [
  { id: 'playtime', label: 'Playtime' },
  { id: 'blocks', label: 'Blocks mined' },
  { id: 'kills', label: 'Mob kills' },
  { id: 'walked', label: 'Walked' },
  { id: 'deaths', label: 'Deaths' },
];
---
<Sub
  title="JerkCraft · agemo.me"
  description="JerkCraft, a Minecraft server for friends: skills, auction house, trading, Bedrock crossplay, and live player stats."
  theme="#79553a"
  fonts={['pixelify']}
  bodyClass="mc"
>
  <Fragment set:html={`<style>body.mc{--dirt:${dirt};--grass:${grass};--stone:${stone}}</style>`} />
  <header class="mc-top">
    <a class="mc-btn mc-btn--small" href="/">← agemo.me</a>
  </header>

  <main id="main">
    <section class="mc-hero" id="top" aria-labelledby="mc-title">
      <div class="mc-sky" aria-hidden="true">
        <span class="mc-cloud" style="--x:6%;--y:18%;--w:14"></span>
        <span class="mc-cloud" style="--x:58%;--y:10%;--w:20"></span>
        <span class="mc-cloud" style="--x:78%;--y:30%;--w:10"></span>
        <span class="mc-sun"></span>
      </div>
      <div class="mc-hero__inner">
        <h1 id="mc-title" class="mc-title">JerkCraft</h1>
        <p class="mc-splash" data-splash aria-hidden="true">Now with Bedrock!</p>
        <p class="mc-lede">A Minecraft server for a group of friends. Vanilla 26.2 client, no mods to install, Java or Bedrock.</p>
        <div class="mc-actions">
          <a class="mc-btn" href="#stats">Live stats</a>
          <a class="mc-btn" href="#join">How to join</a>
        </div>
      </div>
      <div class="mc-ground" aria-hidden="true"></div>
    </section>

    <section class="mc-dirt" id="features" aria-labelledby="features-title">
      <h2 id="features-title" class="mc-h2">What’s on the server</h2>
      <ul class="mc-toasts">
        {features.map((f) => (
          <li class="mc-toast">
            <p class="mc-toast__kicker">{f.cmd}</p>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
      <div class="mc-panel mc-skills">
        <h3 class="mc-panel__title">Skills</h3>
        <ul class="mc-chips">{skills.map((s) => <li>{s}</li>)}</ul>
        <h3 class="mc-panel__title">Mana abilities</h3>
        <ul class="mc-chips mc-chips--gold">{abilities.map((a) => <li>{a}</li>)}</ul>
      </div>
    </section>

    <section class="mc-stone" id="stats" aria-labelledby="stats-title">
      <h2 id="stats-title" class="mc-h2">Live stats</h2>
      <div class="mc-panel mc-stats" data-stats>
        <div class="mc-cards">
          <div class="mc-card"><span class="mc-card__n" data-k="players">–</span><span class="mc-card__l">players</span></div>
          <div class="mc-card"><span class="mc-card__n" data-k="hours">–</span><span class="mc-card__l">hours played, all together</span></div>
          <div class="mc-card"><span class="mc-card__n" data-k="online">–</span><span class="mc-card__l">online at last update</span></div>
        </div>
        <div class="mc-tabs" role="tablist" aria-label="Leaderboard">
          {boards.map((b, i) => (
            <button class="mc-tab" role="tab" id={`tab-${b.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="board" data-board={b.id} tabindex={i === 0 ? 0 : -1}>{b.label}</button>
          ))}
        </div>
        <div id="board" role="tabpanel" aria-labelledby="tab-playtime" data-board-panel>
          <ol class="mc-board" aria-live="polite" data-board-list>
            <li class="mc-board__msg">Loading the scoreboard…</li>
          </ol>
        </div>
        <p class="mc-updated" data-updated>Stats come from the server itself and refresh a few times an hour.</p>
      </div>
    </section>

    <section class="mc-dirt mc-join" id="join" aria-labelledby="join-title">
      <div class="mc-sign">
        <h2 id="join-title">Invite only</h2>
        <p>The address isn’t public. If you know someone on the server, ask them. Otherwise, message me on Discord.</p>
        <a class="mc-btn" href={site.links.discord} rel="noopener">Message Omega</a>
      </div>
      <p class="mc-foot">Not affiliated with Mojang or Microsoft. Player stats are also on <a href="https://dactylus.app/mc/stats/">dactylus.app</a>.</p>
    </section>
  </main>

  <nav class="mc-hotbar" aria-label="Sections">
    {[
      ['top', 'Top'],
      ['features', 'Features'],
      ['stats', 'Stats'],
      ['join', 'Join'],
    ].map(([id, label], i) => (
      <a class="mc-slot" href={`#${id}`} data-slot={id} aria-label={`${label} (key ${i + 1})`} aria-current={i === 0 ? 'true' : undefined}>
        <Fragment set:html={icons[id as keyof typeof icons]} />
        <span class="mc-slot__n" aria-hidden="true">{i + 1}</span>
      </a>
    ))}
  </nav>
</Sub>

<style is:global>
  @font-face {
    font-family: 'Pixelify Sans';
    src: url('/fonts/pixelify.woff2') format('woff2');
    font-weight: 400 700;
    font-display: swap;
  }

  body.mc {
    --px: 'Pixelify Sans', ui-monospace, monospace;
    --ui: #c6c6c6;
    --ui-hi: #ffffff;
    --ui-lo: #555555;
    --ink: #1f1f1f;
    --gold: #ffd84a;
    margin: 0;
    background: #3b2a1c;
    color: #f2f2f2;
    font: 400 1.0625rem/1.5 var(--px);
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
    padding-bottom: 92px;
  }
  .mc *, .mc *::before, .mc *::after { box-sizing: border-box; }
  .mc a { color: inherit; }
  .mc :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }

  .mc .skip {
    position: absolute; left: 16px; top: -100px; z-index: 100;
    padding: 10px 14px; background: var(--gold); color: #000; text-decoration: none;
  }
  .mc .skip:focus { top: 12px; }

  /* The beveled grey button every Minecraft menu is made of. */
  .mc .mc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    background: #7a7a7a;
    color: #fff;
    font: 500 1.125rem var(--px);
    text-decoration: none;
    text-shadow: 2px 2px 0 #3f3f3f;
    border: 2px solid #000;
    box-shadow: inset 2px 2px 0 #aaa, inset -2px -4px 0 #555;
    cursor: pointer;
  }
  .mc .mc-btn:hover { background: #8288b8; box-shadow: inset 2px 2px 0 #b8bde6, inset -2px -4px 0 #4b5080; }
  .mc .mc-btn:active { box-shadow: inset 2px 2px 0 #555, inset -2px -2px 0 #aaa; }
  .mc .mc-btn--small { min-height: 44px; font-size: 1rem; padding: 0 14px; }

  .mc-top {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 14px);
    left: 16px;
    z-index: 5;
  }

  /* ─── hero ─── */
  .mc-hero {
    position: relative;
    min-height: 92vh;
    min-height: 92svh;
    display: grid;
    place-items: center;
    padding: 96px 16px 140px;
    background: linear-gradient(#5f9ee8 0%, #86b7f0 55%, #b9d6f5 100%);
    overflow: hidden;
    text-align: center;
  }
  .mc-sky { position: absolute; inset: 0; pointer-events: none; }
  .mc-sun {
    position: absolute; top: 12%; right: 12%;
    width: 72px; height: 72px;
    background: #fff7c2;
    box-shadow: 0 0 0 8px rgb(255 247 194 / 0.35);
  }
  .mc-cloud {
    position: absolute;
    left: var(--x); top: var(--y);
    width: calc(var(--w) * 1vw); height: 3.2vw; min-height: 18px;
    background: #fff;
    opacity: 0.92;
    box-shadow: calc(var(--w) * 0.25vw) -1.6vw 0 -0.2vw #fff;
    animation: mc-drift 90s linear infinite;
  }
  @keyframes mc-drift { to { transform: translateX(40vw); } }

  .mc-hero__inner { position: relative; max-width: 900px; }
  .mc-title {
    margin: 0;
    font: 700 min(clamp(3.5rem, 2rem + 10vw, 9rem), 13vw)/0.9 var(--px);
    letter-spacing: 0.02em;
    color: #e6e6e6;
    text-shadow:
      0.04em 0.04em 0 #8f8f8f, 0.08em 0.08em 0 #6d6d6d,
      0.12em 0.12em 0 #4a4a4a, 0.16em 0.16em 0 #2d2d2d;
  }
  .mc-splash {
    position: absolute;
    right: -2%;
    top: 58%;
    margin: 0;
    color: var(--gold);
    font: 700 clamp(1rem, 0.7rem + 1.2vw, 1.5rem) var(--px);
    text-shadow: 3px 3px 0 #3f3a10;
    transform: rotate(var(--tilt, -18deg));
    animation: mc-splash 0.9s ease-in-out infinite alternate;
    white-space: nowrap;
  }
  @keyframes mc-splash { to { transform: rotate(var(--tilt, -18deg)) scale(1.08); } }
  @media (max-width: 700px) {
    .mc-splash { position: static; display: inline-block; margin-top: 22px; --tilt: -6deg; }
    .mc-lede { margin-top: 28px; }
  }
  .mc-lede {
    max-width: 34ch;
    margin: 56px auto 28px;
    color: #1d2b3f;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.35;
  }
  .mc-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  .mc-ground {
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 64px;
    background: var(--grass) 0 0 / 64px 64px repeat-x;
    image-rendering: pixelated;
    border-top: 0;
  }

  /* ─── dirt and stone sections ─── */
  .mc-dirt, .mc-stone {
    position: relative;
    padding: clamp(56px, 8vw, 104px) 16px;
    image-rendering: pixelated;
  }
  .mc-dirt { background: linear-gradient(rgb(0 0 0 / 0.45), rgb(0 0 0 / 0.45)), var(--dirt) 0 0 / 64px 64px; }
  .mc-stone { background: linear-gradient(rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.5)), var(--stone) 0 0 / 64px 64px; }
  .mc-dirt > *, .mc-stone > * { image-rendering: auto; }

  .mc-h2 {
    max-width: 1100px;
    margin: 0 auto 28px;
    font: 700 clamp(2rem, 1.4rem + 2.6vw, 3.25rem)/1 var(--px);
    text-shadow: 4px 4px 0 #1b1b1b;
  }

  /* Advancement toasts */
  .mc-toasts {
    max-width: 1100px;
    margin: 0 auto 28px;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 14px;
  }
  .mc-toast {
    padding: 14px 16px 16px;
    background: #212121;
    border: 2px solid #000;
    box-shadow: inset 0 0 0 2px #555, inset 0 0 0 4px #1a1a1a;
    border-radius: 4px;
  }
  .mc-toast__kicker { margin: 0; color: var(--gold); font-size: 0.95rem; }
  .mc-toast h3 { margin: 2px 0 8px; font: 700 1.375rem var(--px); color: #fff; }
  .mc-toast p:last-child { margin: 0; color: #d0d0d0; }

  /* Inventory panel */
  .mc-panel {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(14px, 2.4vw, 28px);
    background: var(--ui);
    color: var(--ink);
    border: 2px solid #000;
    box-shadow: inset 3px 3px 0 var(--ui-hi), inset -3px -3px 0 var(--ui-lo);
  }
  .mc-panel__title { margin: 0 0 10px; font: 700 1.25rem var(--px); color: #3f3f3f; }
  .mc-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 18px; padding: 0; list-style: none; }
  .mc-chips:last-child { margin-bottom: 0; }
  .mc-chips li {
    padding: 4px 10px;
    background: #666666;
    color: #fff;
    text-shadow: 2px 2px 0 #3f3f3f;
    box-shadow: inset 2px 2px 0 #373737, inset -2px -2px 0 #fff;
  }
  .mc-chips--gold li { background: #6b5a1a; color: var(--gold); }

  /* Stats */
  .mc-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 22px; }
  .mc-card {
    display: flex; flex-direction: column; gap: 2px;
    padding: 14px;
    background: #666666;
    box-shadow: inset 2px 2px 0 #373737, inset -2px -2px 0 #fff;
    color: #fff;
  }
  .mc-card__n { font: 700 clamp(1.75rem, 1.2rem + 2vw, 2.75rem)/1 var(--px); text-shadow: 3px 3px 0 #3f3f3f; }
  .mc-card__l { color: #fff; font-size: 0.95rem; }
  @media (max-width: 620px) { .mc-cards { grid-template-columns: 1fr; } }

  .mc-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: -2px; }
  .mc-tab {
    min-height: 44px;
    padding: 0 14px;
    background: #9d9d9d;
    color: #262626;
    font: 500 1rem var(--px);
    border: 2px solid #000;
    border-bottom: 0;
    box-shadow: inset 2px 2px 0 #d6d6d6;
    cursor: pointer;
  }
  .mc-tab[aria-selected='true'] { background: var(--ui); color: #000; position: relative; z-index: 1; }
  .mc-board {
    margin: 0;
    padding: 10px;
    list-style: none;
    background: #666666;
    border: 2px solid #000;
    box-shadow: inset 2px 2px 0 #373737, inset -2px -2px 0 #fff;
    counter-reset: rank;
    min-height: 240px;
  }
  .mc-board li {
    display: grid;
    grid-template-columns: 2.2em 32px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 6px 8px;
    color: #fff;
    text-shadow: 2px 2px 0 #3f3f3f;
  }
  .mc-board li + li { border-top: 2px solid rgb(0 0 0 / 0.15); }
  .mc-board .mc-board__msg { display: block; color: #fff; }
  .mc-rank { color: var(--gold); font-weight: 700; }
  .mc-head { width: 32px; height: 32px; image-rendering: pixelated; background: #5d3f2a; }
  .mc-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mc-name small { color: #b8f28b; margin-left: 6px; font-size: 0.8em; }
  .mc-val { font-variant-numeric: tabular-nums; }
  .mc-bar {
    grid-column: 3 / -1;
    height: 6px;
    background: #2b2b2b;
    margin-top: -4px;
  }
  .mc-bar span { display: block; height: 100%; background: #80ff20; box-shadow: inset 0 -2px 0 #3c8a0c; }
  .mc-updated { margin: 12px 0 0; color: #3f3f3f; font-size: 0.95rem; }

  /* Join sign */
  .mc-join { text-align: center; }
  .mc-sign {
    max-width: 560px;
    margin: 0 auto;
    padding: 28px 24px 30px;
    background: #b58d52;
    color: #2a1d0e;
    border: 4px solid #5d3f2a;
    box-shadow: inset 0 0 0 4px #9c7440, 0 10px 0 -2px #5d3f2a;
  }
  .mc-sign h2 { margin: 0 0 10px; font: 700 2rem var(--px); }
  .mc-sign p { margin: 0 0 20px; font-size: 1.125rem; }
  .mc-foot { margin: 48px auto 0; max-width: 60ch; color: #cfc4b8; font-size: 0.95rem; }

  /* Hotbar */
  .mc-hotbar {
    position: fixed;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 12px);
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    padding: 3px;
    background: rgb(0 0 0 / 0.55);
    border: 2px solid #000;
    box-shadow: inset 0 0 0 2px #8b8b8b;
  }
  .mc-slot {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border: 3px solid transparent;
    text-decoration: none;
  }
  .mc-slot + .mc-slot { box-shadow: -2px 0 0 #8b8b8b; }
  .mc-slot svg { width: 34px; height: 34px; }
  .mc-slot[aria-current='true'] { border-color: #fff; box-shadow: 0 0 0 2px #000, inset 0 0 0 2px #000; }
  .mc-slot__n {
    position: absolute; right: 4px; bottom: 0;
    font: 700 0.85rem var(--px); color: #fff; text-shadow: 2px 2px 0 #3f3f3f;
  }

  html:has(body.mc) { scroll-behavior: smooth; background: #3b2a1c; }
  @media (prefers-reduced-motion: reduce) {
    .mc-cloud, .mc-splash { animation: none; }
    html:has(body.mc) { scroll-behavior: auto; }
  }
</style>

<script>
  import { initJerkcraft } from '../scripts/jerkcraft.js';
  initJerkcraft();
</script>
