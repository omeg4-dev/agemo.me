---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import data from '../data/links.json';

// Group by tag, preserving file order
const groups = [];
for (const link of data.links) {
  const tag = link.tag || 'misc';
  let group = groups.find((g) => g.tag === tag);
  if (!group) groups.push((group = { tag, items: [] }));
  group.items.push(link);
}

const host = (url) => {
  try {
    return new URL(url).host.replace(/^www\./, '');
  } catch {
    return url;
  }
};

const total = String(data.links.length).padStart(2, '0');
---
<Base title="links · Omega ⟷ agemO" description="Things worth keeping a pointer to.">
  <Nav here="links" />

  <main class="vault">
    <header class="vault__head">
      <p class="vault__eyebrow">{total} kept</p>
      <h1 class="vault__title">links</h1>
      <p class="vault__lede">Things worth keeping a pointer to. No affiliate codes, no rankings.</p>
    </header>

    {groups.map((group) => (
      <section class="group" aria-labelledby={`group-${group.tag}`} data-link-group>
        <h2 class="group__tag" id={`group-${group.tag}`}>{group.tag}</h2>

        <ul class="group__rows">
          {group.items.map((link, i) => (
            <li class="row">
              <span class="row__bar" aria-hidden="true"></span>
              <a class="row__hit" href={link.url} target="_blank" rel="noopener noreferrer">
                <span class="row__ordinal" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

                <span class="row__stack">
                  <span class="row__title">{link.title}</span>
                  <span class="row__host">{host(link.url)}</span>
                </span>

                {link.note && <span class="row__note">{link.note}</span>}
                <span class="row__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>

  <Footer />
</Base>

<style>
  .vault {
    max-width: 1200px;
    margin-inline: auto;
    padding: clamp(5rem, 12vh, 8rem) var(--gutter) clamp(3rem, 8vh, 6rem);
    display: grid;
    gap: clamp(3rem, 8vh, 6rem);
  }

  .vault__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .vault__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--graphite);
    margin: 0;
  }

  .vault__title {
    font-family: var(--font-display);
    font-stretch: 62%;
    font-weight: 800;
    font-size: clamp(2.5rem, 9vw, 6.5rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
  }

  .vault__lede {
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    color: var(--graphite);
    max-width: 50ch;
    margin: 0;
  }

  .group {
    display: grid;
    gap: 1.5rem;
  }

  .group__tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--graphite);
    margin: 0;
  }

  .group__tag::before {
    content: '— ';
    color: var(--signal);
  }

  .group__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .row {
    position: relative;
    border-top: 1px solid var(--hairline);
    transition: background-color var(--dur-1) var(--ease);
  }

  .group__rows > .row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .row:hover,
  .row:focus-within {
    background: var(--paper-2);
  }

  .row__bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--signal);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-2) var(--ease);
    pointer-events: none;
  }

  .row:hover .row__bar,
  .row:focus-within .row__bar {
    transform: scaleY(1);
  }

  .row__hit {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: clamp(1rem, 3vw, 2.5rem);
    row-gap: 0.4rem;
    padding: clamp(1.2rem, 2.5vw, 1.75rem) clamp(0.75rem, 2vw, 1.5rem);
    color: inherit;
    text-decoration: none;
    min-height: 44px;
  }

  .row__ordinal {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--graphite);
  }

  .row__stack {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    min-height: 1.8rem;
  }

  .row__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 75%;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .row__host {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--graphite);
  }

  .row__note {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--graphite);
    grid-column: 2;
    grid-row: 2;
    max-width: 60ch;
  }

  .row__go {
    font-family: var(--font-mono);
    color: var(--signal);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease);
  }

  .row:hover .row__go,
  .row:focus-within .row__go {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 640px) {
    .row__hit {
      grid-template-columns: auto 1fr;
    }
    .row__go {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row__bar,
    .row__go {
      transition: none !important;
    }
  }
</style>

<script>
  import { initScroll } from '../scripts/scroll.js';
  initScroll();
</script>
