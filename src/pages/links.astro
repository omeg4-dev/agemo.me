---
import Base from '../layouts/Base.astro';
import Reflected from '../components/Reflected.astro';
import data from '../data/links.json' with { type: 'json' };

// Rows are grouped by tag, in the order the tags first appear in the file.
const groups: { tag: string; items: typeof data.links }[] = [];
for (const link of data.links) {
  const tag = link.tag || 'misc';
  let group = groups.find((g) => g.tag === tag);
  if (!group) groups.push((group = { tag, items: [] }));
  group.items.push(link);
}

const host = (url: string) => {
  try { return new URL(url).host.replace(/^www\./, ''); } catch { return url; }
};
---
<Base title="Links · Omega ⟷ agemO" description="Pointers worth keeping." here="links">
  <div class="page">
    <Reflected text="Links" />
    {groups.map((g) => (
      <section class="group" aria-labelledby={`tag-${g.tag}`}>
        <h2 class="mono" id={`tag-${g.tag}`}>{g.tag}</h2>
        <ul class="repos">
          {g.items.map((l) => (
            <li class="repo">
              <a class="repo__link" href={l.url} rel="noopener">
                <span class="repo__name" data-name={l.title} data-long={l.title.length > 12 ? '' : undefined}>{l.title}</span>
                <p class="repo__desc">{l.note}</p>
                <span class="repo__meta mono">
                  <span class="repo__lang">{host(l.url)}</span>
                  <span class="repo__arrow" aria-hidden="true">↗</span>
                </span>
                <span class="repo__sub mono">{host(l.url)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
