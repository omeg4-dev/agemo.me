---
import Base from '../layouts/Base.astro';
import Ambient from '../components/Ambient.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { accentFor } from '../../scripts/repos-transform.mjs';
import data from '../data/links.json';

// Rows are grouped by tag, and the groups appear in the order their first
// member appears in links.json — so reordering the file reorders the page and
// there is no second list to keep in step.
const groups = [];
for (const link of data.links) {
  const tag = link.tag || 'misc';
  let group = groups.find((g) => g.tag === tag);
  if (!group) groups.push((group = { tag, items: [] }));
  group.items.push(link);
}

const host = (url) => {
  try { return new URL(url).host.replace(/^www\./, ''); }
  catch { return url; }
};

const total = String(data.links.length).padStart(2, '0');
---
<Base title="links · Omega ⟷ agemO" description="Things worth keeping a pointer to.">
  <Ambient />
  <Nav here="links" />

  <main class="vault">
    <header class="vault__head" data-reveal>
      <p class="vault__eyebrow">{total} kept</p>
      <h1 class="vault__title">
        <span>Links</span>
        <span class="vault__echo" aria-hidden="true">Links</span>
      </h1>
      <p class="vault__lede">Things worth keeping a pointer to. No affiliate codes, no rankings.</p>
    </header>

    {groups.map((group) => (
      <section class="group" aria-labelledby={`group-${group.tag}`} data-link-group>
        <h2 class="group__tag" id={`group-${group.tag}`}>{group.tag}</h2>

        <ul class="group__rows">
          {group.items.map((link, i) => (
            <li class="row" data-reveal style={`--row-accent: ${accentFor(link.title)}; --i: ${i}`}>
              <a class="row__hit" href={link.url} target="_blank" rel="noopener noreferrer">
                <span class="row__ordinal" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

                {/* Two boxes, not one. .row__stack clips; .row__slide moves.
                    Translating the clipping box itself moves its clip along
                    with it, so the whole thing just slides up the page and the
                    second line never comes into view — which is exactly what
                    the first version did. */}
                <span class="row__stack">
                  <span class="row__slide">
                    <span class="row__title">{link.title}</span>
                    <span class="row__host">{host(link.url)}</span>
                  </span>
                </span>

                {link.note && <span class="row__note">{link.note}</span>}
                <span class="row__go" aria-hidden="true">→</span>
              </a>
              <span class="row__wash" aria-hidden="true"></span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>

  <Footer />
</Base>

<style>
  .vault {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin-inline: auto;
    padding: clamp(6rem, 16vh, 10rem) var(--gutter) clamp(3rem, 10vh, 6rem);
    display: grid;
    gap: clamp(2.5rem, 8vh, 5rem);
  }

  .vault__head { display: grid; gap: 0.9rem; }

  .vault__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--accent) 70%, var(--muted));
  }

  .vault__title {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(3rem, 13vw, 9rem);
    font-weight: 400;
    /* 1, not 0.9: a box shorter than its own glyphs puts `top: 100%` —
       where the reflection hangs — inside the letterforms. */
    line-height: 1;
    /* The echo hangs below the baseline; without room for it the lede
       collides with the reflection. */
    margin-bottom: 0.72em;
  }
  .vault__echo {
    position: absolute;
    inset: 100% auto auto 0;
    /* No transform-origin. scaleY(-1) about `top` maps the box to [-h, 0] —
       it renders ABOVE its own top edge, i.e. straight back over the thing it
       is meant to reflect. The default 50% 50% origin flips in place, so the
       reflection stays in the box, and the box is placed below. */
    transform: scaleY(-1);
    color: color-mix(in oklab, var(--accent) 45%, transparent);
    -webkit-mask-image: linear-gradient(to top, transparent 15%, #000);
    mask-image: linear-gradient(to top, transparent 15%, #000);
    pointer-events: none;
    animation: vault-ripple 6.5s var(--ease) infinite alternate;
  }
  @keyframes vault-ripple {
    from { transform: scaleY(-1) skewX(0deg)   translateY(0); opacity: 0.7; }
    to   { transform: scaleY(-1) skewX(-2.5deg) translateY(3px); opacity: 1; }
  }

  .vault__lede { color: var(--muted); max-width: 46ch; font-size: 0.9rem; }

  .group { display: grid; gap: 1rem; }
  .group__tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .group__tag::before { content: '— '; color: var(--accent); }

  .group__rows { list-style: none; margin: 0; padding: 0; display: grid; }

  .row {
    position: relative;
    border-top: 1px solid color-mix(in oklab, var(--muted) 18%, transparent);
    transition-delay: calc(min(var(--i, 0), 6) * 70ms) !important;
  }
  .group__rows > .row:last-child { border-bottom: 1px solid color-mix(in oklab, var(--muted) 18%, transparent); }

  .row__hit {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: clamp(1rem, 4vw, 2.5rem);
    /* The note belongs under the title, not a column-gap away from it. */
    row-gap: 0.4rem;
    padding: clamp(1.1rem, 3vw, 1.9rem) clamp(0.4rem, 2vw, 1.2rem);
    color: inherit;
    text-decoration: none;
  }

  .row__ordinal {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: color-mix(in oklab, var(--row-accent) 60%, transparent);
  }

  /* One line tall, clipped, holding two lines.
     --line is an explicit length rather than an em, because `em` on .row__stack
     resolves against the STACK's inherited 1rem font-size while the title
     inside it is clamp(1.5rem, 4.5vw, 2.6rem). The first version used 1.15em
     and produced a box a third the height of the text it contained, guillotining
     every title. Anything that sizes the box must be in the same units as the
     thing being boxed. */
  .row {
    --line: clamp(2.1rem, 6vw, 3.5rem);
  }
  .row__stack {
    overflow: hidden;
    height: var(--line);
  }
  .row__slide {
    display: grid;
    grid-auto-rows: var(--line);
    transition: transform var(--dur-2) var(--ease);
  }
  .row__title, .row__host {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.5vw, 2.6rem);
    line-height: var(--line);
    white-space: nowrap;
  }
  .row__title { color: var(--text); }
  .row__host {
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 2.4vw, 1.4rem);
    color: var(--row-accent);
  }
  .row:hover .row__slide, .row:focus-within .row__slide { transform: translateY(calc(-1 * var(--line))); }

  .row__note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--muted);
    grid-column: 2;
    grid-row: 2;
    max-width: 52ch;
  }

  .row__go {
    font-family: var(--font-mono);
    color: var(--row-accent);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease);
  }
  .row:hover .row__go, .row:focus-within .row__go { opacity: 1; transform: none; }

  .row__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg,
      color-mix(in oklab, var(--row-accent) 14%, transparent), transparent 55%);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease);
  }
  .row:hover .row__wash, .row:focus-within .row__wash { opacity: 1; }

  @media (max-width: 620px) {
    .row__hit { grid-template-columns: auto 1fr; }
    .row__go { display: none; }
  }

  /* A touch device never fires :hover, so on a phone the swap above can never
     run and the destination host -- which is information, not decoration --
     was simply unreachable. Stop clipping and show both lines outright. Keyed
     off the pointer, not the width: a small window on a laptop still hovers,
     and a large tablet still does not. */
  @media (hover: none) {
    .row__stack { height: auto; }
    .row__slide { transform: none; }
    .row__title, .row__host { display: block; }
    .row__host { font-size: clamp(0.78rem, 2vw, 1rem); opacity: 0.8; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vault__echo { animation: none; }
    /* The stack still swaps to the host on hover — that is information, not
       decoration. Only the slide goes. */
    .row__slide, .row__go { transition: none; }
  }
</style>

<script>
  import { initScroll } from '../scripts/scroll.js';
  initScroll();
</script>
