---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Elsewhere from '../components/Elsewhere.astro';
---
<Base title="Omega ⟷ agemO" description="Omega makes small programs, mostly in Python: a clipboard history, party games for the TV, desktop widgets.">
  <Hero />
  <section class="section" aria-label="About">
    <div class="statement">
      <p>
        I make things I want for myself: a clipboard history, party games for
        the TV that you play with your phone, a few widgets for my desktop.
        Mostly Python, all of it on GitHub.
      </p>
      <p class="aside">I use cachyos with hyprland.</p>
    </div>
  </section>
  <Work />
  <Elsewhere />
</Base>
