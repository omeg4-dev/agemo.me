---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Elsewhere from '../components/Elsewhere.astro';
---
<Base title="Omega ⟷ agemO" description="Omega writes small, stubborn software: a clipboard that remembers, games for the living-room TV, widgets nobody asked for.">
  <Hero />
  <section class="section" aria-label="About">
    <div class="statement">
      <p>
        I’m Omega. I write small, <em>stubborn</em> software — a clipboard that
        remembers everything, games for the living-room TV played from phones,
        widgets nobody asked for. Mostly Python. Everything <em>open</em>.
      </p>
      <p class="aside">written and run on a cachyos box with hyprland on top.</p>
    </div>
  </section>
  <Work />
  <Elsewhere />
</Base>
