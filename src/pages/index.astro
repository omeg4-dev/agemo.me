---
// index.astro: Desktop shell with hyprlock screen, 5 tiled workspaces, interactive terminal, launcher
import Base from '../layouts/Base.astro';
import Wallpaper from '../components/Wallpaper.astro';
import Bar from '../components/Bar.astro';
import Lock from '../components/Lock.astro';
import KeysOverlay from '../components/KeysOverlay.astro';
import Launcher from '../components/Launcher.astro';
import Mirror from '../components/Mirror.astro';
import Terminal from '../components/Terminal.astro';
import Window from '../components/Window.astro';
import Work from '../components/Work.astro';
import Machine from '../components/Machine.astro';
import LinksWorkspace from '../components/LinksWorkspace.astro';
import Reach from '../components/Reach.astro';
import site from '../config/site.mjs';
---
<Base title="Omega ⟷ agemO" description={site.tagline}>
  <Wallpaper />
  <Bar here="home" />
  <Lock />
  <KeysOverlay />
  <Launcher />

  <main class="desktop-main">
    <!-- WS1 Home -->
    <section class="ws-home" id="ws-home" data-ws data-hero>
      <div class="ws-home__art wrap">
        <Mirror word="OMEGA" ariaLabel="Omega" variant="hero" />
        <p class="ws-home__tagline hero__tagline">{site.tagline}</p>
      </div>

      <div class="ws-home__windows">
        <Window title="now" app="lanyard" class="now-win" i={0}>
          <div class="now" data-presence data-discord-id={site.discordId}>
            <div class="now__row">
              <span class="now__dot" aria-hidden="true"></span>
              <span class="now__state" data-presence-state data-state="offline">checking…</span>
            </div>
            <div class="now__act">
              <span class="now__label">activity:</span>
              <span class="now__val" data-presence-activity>—</span>
            </div>
            <div class="now__time-row">
              <span class="now__label">clock:</span>
              <span class="now__val" data-clock>—</span>
            </div>
          </div>
        </Window>

        <Terminal />
      </div>
    </section>

    <!-- WS2 Work -->
    <Work />

    <!-- WS3 Machine -->
    <Machine />

    <!-- WS4 Links -->
    <LinksWorkspace />

    <!-- WS5 Reach (contains footer) -->
    <Reach />
  </main>
</Base>

<style>
  .desktop-main {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .desktop-main > :global(section[data-ws]) {
    min-height: 100vh;
    min-height: 100svh;
    padding: calc(44px + 2 * var(--gap-outer)) var(--gap-outer) var(--gap-outer);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  @media (max-width: 1099px) {
    .desktop-main > :global(section[data-ws]) {
      min-height: auto;
      padding-top: calc(48px + 1.5 * var(--gap-outer));
      padding-bottom: clamp(2.5rem, 6vh, 4rem);
    }
  }

  .wrap {
    width: 100%;
    max-width: 1200px;
    padding-inline: 0;
  }

  /* WS1 Layout */
  .ws-home {
    position: relative;
    overflow: hidden;
  }

  .ws-home__art {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: clamp(1rem, 4vh, 3rem);
  }

  .ws-home__tagline {
    margin-top: clamp(1rem, 2vh, 1.75rem);
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1rem + 0.8vw, 1.6rem);
    color: var(--base04);
    max-width: 60ch;
    line-height: 1.45;
  }

  .ws-home__windows {
    display: flex;
    flex-direction: column;
    gap: var(--gap-inner);
    z-index: 2;
  }

  @media (min-width: 1100px) {
    .ws-home__windows {
      position: absolute;
      right: var(--gap-outer);
      top: calc(44px + 2 * var(--gap-outer));
      bottom: var(--gap-outer);
      justify-content: space-between;
      align-items: flex-end;
      pointer-events: none;
    }

    .ws-home__windows > :global(*) {
      pointer-events: auto;
    }
  }

  @media (max-width: 1099px) {
    .ws-home__windows {
      margin-top: 32px;
      width: 100%;
    }
  }

  /* "now" window styles */
  .now-win {
    width: 100%;
    max-width: 320px;
  }

  .now {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .now__row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .now__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--base03);
    transition: background var(--dur-1) var(--ease);
  }

  .now:has([data-state='online']) .now__dot {
    background: var(--green);
  }
  .now:has([data-state='idle']) .now__dot,
  .now:has([data-state='dnd']) .now__dot {
    background: var(--accent);
  }

  .now__state {
    color: var(--text);
    font-weight: 700;
  }

  .now__act,
  .now__time-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .now__label {
    color: var(--text-dim);
  }

  .now__val {
    color: var(--base04);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script>
  import { initScroll } from '../scripts/scroll.js';
  import { initMirrorLine } from '../scripts/mirror-line.js';
  import { initPresence } from '../scripts/presence.js';

  initScroll();
  initMirrorLine();
  initPresence();
</script>
