---
// Footer.astro: Desktop shell footer with palindrome, build SHA, metadata and top link
const sha = typeof __BUILD_SHA__ !== 'undefined' ? __BUILD_SHA__ : 'local';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="foot__row">
    <p class="foot__palindrome" aria-hidden="true">
      <span>OMEGA</span>
      <svg class="foot__arrow" aria-hidden="true" focusable="false" viewBox="0 0 48 12">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 6h36M6 6l4.5-4M6 6l4.5 4M42 6l-4.5-4M42 6l-4.5 4"
        />
      </svg>
      <span>AGEMO</span>
    </p>

    <span class="foot__sep" aria-hidden="true">/</span>

    <p class="foot__meta">
      built from <code data-build-sha>{sha}</code>
    </p>

    <span class="foot__sep" aria-hidden="true">/</span>

    <p class="foot__tech">astro · no trackers</p>

    <span class="foot__sep" aria-hidden="true">/</span>

    <p class="foot__year">© {year}</p>

    <a class="foot__top" href="#ws-home">back to top ↑</a>
  </div>
</footer>

<style>
  .foot {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--base02);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
  }

  .foot__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .foot__palindrome {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    text-transform: uppercase;
  }

  .foot__arrow {
    width: 2.2em;
    height: 0.6em;
    flex: none;
    color: var(--pink);
  }

  .foot__sep {
    color: var(--base02);
  }

  .foot__meta,
  .foot__tech,
  .foot__year {
    margin: 0;
  }

  .foot__meta code {
    color: var(--text);
  }

  .foot__top {
    margin-left: auto;
    color: var(--accent);
    text-decoration: none;
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    transition: color var(--dur-1) var(--ease);
  }

  .foot__top:hover,
  .foot__top:focus-visible {
    color: var(--accent-2);
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .foot__top {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
