---
const sha = __BUILD_SHA__;
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="foot__row wrap">
    <p class="foot__palindrome" aria-hidden="true">
      <span>OMEGA</span>
      <svg class="foot__arrow" aria-hidden="true" focusable="false" viewBox="0 0 48 12">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 6h36M6 6l4.5-4M6 6l4.5 4M42 6l-4.5-4M42 6l-4.5 4"
        />
      </svg>
      <span>AGEMO</span>
    </p>

    <span class="foot__sep" aria-hidden="true">/</span>

    <p class="foot__meta">
      sha <code data-build-sha>{sha}</code>
    </p>

    <span class="foot__sep" aria-hidden="true">/</span>

    <p class="foot__year">{year}</p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--hairline);
    padding-block: clamp(4rem, 8vh, 6rem) clamp(3rem, 6vh, 5rem);
    margin-top: clamp(4rem, 10vh, 8rem);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--graphite);
  }

  .foot__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem 1.25rem;
  }

  .foot__palindrome {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin: 0;
    text-transform: uppercase;
  }

  .foot__arrow {
    width: 2.2em;
    height: 0.6em;
    flex: none;
    color: var(--signal);
  }

  .foot__sep {
    color: var(--hairline);
  }

  .foot__meta,
  .foot__year {
    margin: 0;
  }

  .foot__meta code {
    color: var(--ink);
  }
</style>
