---
import site from '../config/site.mjs';
---
<section class="identity wrap" id="identity" data-reveal>
  <p class="identity__line">{site.tagline}</p>
</section>

<style>
  .identity {
    padding-block: clamp(3rem, 8vh, 5rem);
  }

  .identity__line {
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.1rem + 0.6vw, 1.5rem);
    line-height: 1.5;
    color: var(--ink);
    max-width: var(--measure);
    margin: 0;
  }
</style>
