---
const {
  word = 'OMEGA',
  ariaLabel = word === 'OMEGA' ? 'Omega' : word,
  as: Tag = 'h1',
  variant = 'hero',
  cssWidth = word === '404' ? '2.03em' : '3.9em',
} = Astro.props;
---
<div class={`mirror mirror--${variant}`} data-mirror style={`--w: ${cssWidth};`}>
  <Tag class="mirror__h1" aria-label={ariaLabel}>
    <span class="mirror__word">{word}</span>
  </Tag>
  <span class="mirror__image" aria-hidden="true">{word}</span>
  <span class="mirror__line" aria-hidden="true"></span>
</div>

<style>
  .mirror {
    --x: var(--w);
    position: relative;
    display: inline-block;
    width: calc(var(--w) * 2);
    /* The reflection is anchored to this box's left edge, so the word must be too —
       an inherited text-align: center (the 404 page) slid it w/2 to the right. */
    text-align: left;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 100%;
    text-transform: uppercase;
    line-height: 0.85;
    user-select: none;
  }

  .mirror--hero {
    font-size: calc((100vw - 2 * var(--gap-outer)) * 0.62 / 7.85);
  }
  @supports (container-type: inline-size) {
    .mirror--hero {
      font-size: min(9.5rem, calc(100cqw / 7.85));
    }
  }

  .mirror--small {
    font-size: min(6.5rem, calc((min(100vw, 1200px) - 2 * var(--gap-outer)) / 16));
  }

  .mirror__h1 {
    margin: 0;
    padding: 0;
    display: inline-block;
    font: inherit;
    line-height: inherit;
    color: inherit;
    font-weight: inherit;
    font-stretch: inherit;
  }

  .mirror__word {
    display: inline-block;
    width: var(--w);
    white-space: nowrap;
    clip-path: inset(0 calc(100% - var(--x)) 0 0);
    color: var(--blue);
    background: linear-gradient(135deg, var(--blue) 0%, var(--purple) 50%, var(--pink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .mirror__image {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--w);
    white-space: nowrap;
    transform-origin: 0 50%;
    transform: translateX(calc(var(--x) * 2)) scaleX(-1);
    clip-path: inset(0 calc(100% - var(--x)) 0 0);
    color: var(--blue);
    opacity: 0.55;
    background: linear-gradient(135deg, var(--blue) 0%, var(--purple) 50%, var(--pink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.15) 100%);
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.15) 100%);
    pointer-events: none;
  }

  @supports not (background-clip: text) {
    .mirror__word,
    .mirror__image {
      background: none;
      -webkit-text-fill-color: initial;
      color: var(--blue);
    }
  }

  .mirror__line {
    position: absolute;
    left: 0;
    top: -0.15em;
    bottom: -0.15em;
    width: 2px;
    background: var(--pink);
    box-shadow: 0 0 10px var(--pink), 0 0 20px rgb(238 83 150 / 0.4);
    transform: translateX(var(--x));
    pointer-events: none;
  }
</style>
