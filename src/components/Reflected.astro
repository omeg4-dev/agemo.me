---
// A page title with its reflection standing beside it, across a line of glass.
interface Props { text: string }
const { text } = Astro.props;
const long = text.length > 5 ? '' : undefined;
---
<div class="title">
  <h1>{text}</h1>
  <span class="title__rule" data-long={long} aria-hidden="true"></span>
  <span class="title__ghost" data-long={long} aria-hidden="true">{text}</span>
</div>
