---
// Reach.astro: Workspace 5 (Reach) - Direct links to Discord and GitHub + Footer
import Window from './Window.astro';
import Footer from './Footer.astro';
import site from '../config/site.mjs';

const discordHost = 'discord.com/users/' + site.discordId;
const githubHost = 'github.com/' + site.owner;
---
<section class="reach" id="ws-reach" aria-labelledby="reach-heading" data-reach data-ws>
  <header class="reach__head">
    <h2 class="section-heading" id="reach-heading">reach</h2>
    <p class="section-sub">contact & coordinates · no forms, no trackers</p>
  </header>

  <div class="reach__grid">
    <Window title="discord" app="client" accent="var(--purple)" class="reach__win" i={0}>
      <a
        href={site.links.discord}
        target="_blank"
        rel="noopener noreferrer"
        class="reach__target"
        aria-label={`Discord: ${discordHost}`}
      >
        <span class="reach__word">Discord</span>
        <span class="reach__host">→ {discordHost}</span>
      </a>
    </Window>

    <Window title="github" app="browser" accent="var(--blue)" class="reach__win" i={1}>
      <a
        href={site.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="reach__target"
        aria-label={`GitHub: ${githubHost}`}
      >
        <span class="reach__word">GitHub</span>
        <span class="reach__host">→ {githubHost}</span>
      </a>
    </Window>
  </div>

  <Footer />
</section>

<style>
  .reach {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    content-visibility: auto;
    contain-intrinsic-size: 600px;
  }

  .reach__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-left: 0;
  }

  .section-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 62%;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--blue);
    background: linear-gradient(135deg, var(--blue) 0%, var(--purple) 50%, var(--pink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0;
  }

  @supports not (background-clip: text) {
    .section-heading {
      background: none;
      -webkit-text-fill-color: initial;
      color: var(--blue);
    }
  }

  .section-sub {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .reach__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-inner);
    width: 100%;
  }

  @media (min-width: 800px) {
    .reach__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .reach__target {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(16px, 3vw, 32px);
    text-decoration: none;
    color: inherit;
    min-height: 180px;
  }

  .reach__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 62%;
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--text);
    transition: transform var(--dur-2) var(--ease);
  }

  .reach__win:hover .reach__word,
  .reach__win:focus-within .reach__word {
    transform: translateX(6px);
  }

  .reach__host {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    color: var(--text-dim);
    margin-top: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
