---
import site from '../config/site.mjs';

const targets = [
  { label: 'Discord', href: site.links.discord, host: '→ discord.com' },
  { label: 'GitHub', href: site.links.github, host: '→ github.com' },
];
---
<section class="reach" aria-labelledby="reach-heading" data-reach data-reveal>
  <div class="reach__rule" aria-hidden="true"></div>
  <header class="reach__head">
    <p class="section-label">reach</p>
    <h2 class="section-heading" id="reach-heading">Reach</h2>
  </header>

  <div class="reach__links">
    {targets.map((t) => (
      <a class="reach__target" href={t.href} target="_blank" rel="noopener noreferrer">
        <span class="reach__word">
          {t.label}
          <span class="reach__line" aria-hidden="true"></span>
        </span>
        <span class="reach__host">{t.host}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .reach {
    max-width: 1200px;
    margin-inline: auto;
    padding: clamp(5rem, 12vw, 10rem) var(--gutter) 0;
    display: grid;
    gap: clamp(2.5rem, 6vh, 4rem);
  }

  .reach__rule {
    width: 100%;
    height: 1px;
    background: var(--hairline);
    margin-bottom: clamp(1rem, 3vh, 2rem);
  }

  .reach__head {
    display: flex;
    flex-direction: column;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--graphite);
    margin: 0 0 0.5rem 0;
  }

  .section-heading {
    font-family: var(--font-display);
    font-stretch: 62%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.25rem, 7vw, 5.5rem);
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: var(--ink);
    margin: 0;
  }

  .reach__links {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vh, 3rem);
  }

  .reach__target {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    text-decoration: none;
    color: inherit;
    min-height: 44px;
    padding-block: 0.5rem;
  }

  @media (min-width: 720px) {
    .reach__target {
      flex-direction: row;
      align-items: baseline;
      gap: 2rem;
    }
  }

  .reach__word {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 62%;
    font-size: clamp(2.5rem, 9vw, 7rem);
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--ink);
    overflow: hidden;
  }

  .reach__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--signal);
    transform: translateX(-4px);
    opacity: 0;
    pointer-events: none;
    transition: transform var(--dur-2) var(--ease), opacity var(--dur-1) var(--ease);
  }

  .reach__target:hover .reach__line,
  .reach__target:focus-visible .reach__line {
    opacity: 1;
    transform: translateX(calc(100% + 4px));
  }

  .reach__host {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--graphite);
    transition: color var(--dur-1) var(--ease);
  }

  .reach__target:hover .reach__host,
  .reach__target:focus-visible .reach__host {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .reach__line {
      display: none;
    }
  }
</style>
