---
import site from '../config/site.mjs';

const { here } = Astro.props;

const items = [
  { label: 'home', href: '/', current: here === 'home', external: false },
  { label: 'links', href: '/links', current: here === 'links', external: false },
  { label: 'github', href: site.links.github, current: false, external: true },
];
---
<nav class="nav" aria-label="Primary">
  <div class="nav__inner wrap">
    <a class="nav__home" href="/" aria-current={here === 'home' ? 'page' : undefined}>omega</a>
    <ul class="nav__list">
      {items.map((i) => (
        <li>
          <a
            class="nav__link"
            href={i.href}
            aria-current={i.current ? 'page' : undefined}
            target={i.external ? '_blank' : undefined}
            rel={i.external ? 'noopener noreferrer' : undefined}
          >{i.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--hairline);
    padding: 0.6rem 0;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: lowercase;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__home, .nav__link {
    position: relative;
    color: var(--graphite);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    margin-block: -0.5rem;
  }

  .nav__home {
    color: var(--ink);
    font-weight: 700;
  }

  .nav__home:hover, .nav__link:hover, .nav__link:focus-visible {
    color: var(--ink);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 50%;
    margin-bottom: -0.85em;
    height: 2px;
    background: var(--signal);
    transform: scaleX(0);
    transition: transform var(--dur-2) var(--ease);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav__link[aria-current='page'] {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__link::after {
      transition: none;
    }
  }
</style>
