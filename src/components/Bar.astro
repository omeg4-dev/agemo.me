---
// Bar.astro: Noctalia-style floating top bar with workspaces, active window title, presence and clock
import site from '../config/site.mjs';

interface Props {
  here?: string;
}

const { here = 'home' } = Astro.props;

const workspaces = [
  { num: 1, name: 'home', label: 'home' },
  { num: 2, name: 'work', label: 'work' },
  { num: 3, name: 'machine', label: 'machine' },
  { num: 4, name: 'links', label: 'links' },
  { num: 5, name: 'reach', label: 'reach' },
];

const isHome = here === 'home';
---
<nav class="bar" id="bar" aria-label="Desktop bar">
  <div class="bar__left">
    <a href={isHome ? '#ws-home' : '/'} class="bar__badge" aria-label="home">
      <svg viewBox="0 0 64 64" width="26" height="26" aria-hidden="true" focusable="false">
        <rect width="64" height="64" rx="32" fill="#161616" stroke="var(--base02)" stroke-width="1.5" />
        <g transform="translate(8.4891 6) scale(0.065549)">
          <path
            fill="var(--accent)"
            stroke="var(--accent)"
            stroke-width="20"
            stroke-linejoin="round"
            d="M408.9998779296875 18.60003662109375V135.79998779296875Q408.9998779296875 146.79998779296875 411.4998779296875 149.19998168945312Q413.9998779296875 151.5999755859375 425.19989013671875 155.5999755859375Q451.5999755859375 164.60003662109375 479.89990234375 178.50006103515625Q508.1998291015625 192.40008544921875 532.5997009277344 215.10006713867188Q556.9995727539062 237.800048828125 572.199462890625 275.0999450683594Q587.3993530273438 312.39984130859375 587.3993530273438 367.9996337890625Q587.3993530273438 430.5997314453125 565.4993896484375 477.59979248046875Q543.5994262695312 524.599853515625 507.1994934082031 556.0998840332031Q470.799560546875 587.5999145507812 425.7996520996094 603.3999328613281Q380.79974365234375 619.199951171875 335.39984130859375 619.199951171875Q280.4000244140625 619.199951171875 231.2001953125 595.8999938964844Q182.0003662109375 572.6000366210938 150.80047607421875 524.9000854492188Q119.6005859375 477.20013427734375 119.6005859375 403.60015869140625Q119.6005859375 315.8001708984375 164.4005126953125 255.30010986328125Q209.200439453125 194.800048828125 307.0001220703125 157Q315.80010986328125 153 317.80010986328125 148.0Q319.80010986328125 143 319.80010986328125 133V18.60003662109375L293.80010986328125 12V116Q293.80010986328125 129 289.7001037597656 134.5Q285.60009765625 140 272.80010986328125 144Q164.00006103515625 174 106.50003051757812 231.0Q49 288 49 379.20001220703125Q49 441.20001220703125 74.10000610351562 489.6000061035156Q99.20001220703125 538 143.70001220703125 571.5Q188.20001220703125 605 246.39999389648438 622.0Q304.5999755859375 639 369.99993896484375 639Q462.9998779296875 639 526.89990234375 606.6000061035156Q590.7999267578125 574.2000122070312 624.3999633789062 518.1000061035156Q658 462 658 390.39996337890625Q658 329.5999755859375 636.7999877929688 287.1999816894531Q615.5999755859375 244.79998779296875 581.9999694824219 216.89999389648438Q548.3999633789062 189 512.0999450683594 171.5Q475.7999267578125 154 445.39990234375 143Q435.39990234375 139 435.39990234375 132V12ZM408.9998779296875 18.60003662109375Q486.99969482421875 18.60003662109375 537.6997375488281 29.500091552734375Q588.3997802734375 40.400146484375 617.1998901367188 64.40020751953125Q646 88.4002685546875 656.2000122070312 127.60028076171875Q657.2000122070312 129.80029296875 663.2000122070312 128.70028686523438Q669.2000122070312 127.60028076171875 668.2000122070312 124.80029296875L627.3999633789062 -30Q626.3999633789062 -33 620.3999633789062 -32.0Q614.3999633789062 -31 615.3999633789062 -28Q618.199951171875 -11 607.7999572753906 -5.5Q597.3999633789062 0 559 0Q533 0 503.5999450683594 0.0Q474.19989013671875 0 426.19989013671875 0Q420.19989013671875 0 414.5998840332031 5.9000244140625Q408.9998779296875 11.800048828125 408.9998779296875 18.60003662109375ZM319.80010986328125 18.60003662109375Q319.80010986328125 11.800048828125 316.4001159667969 5.9000244140625Q313.0001220703125 0 308.0001220703125 0Q281.0001220703125 0 243.50009155273438 0.0Q206.00006103515625 0 173.00003051757812 0.0Q140 0 123 0Q97 0 86.0 -2.5Q75 -5 71.5 -11.0Q68 -17 64 -29Q63 -32 58.0 -30.5Q53 -29 54 -27L97.40008544921875 124.80029296875Q98.40008544921875 127.60028076171875 103.90008544921875 126.60028076171875Q109.40008544921875 125.60028076171875 107.40008544921875 122.80029296875Q96.00006103515625 66.20025634765625 145.40020751953125 42.400146484375Q194.80035400390625 18.60003662109375 319.80010986328125 18.60003662109375Z"
          />
        </g>
      </svg>
    </a>

    <div class="bar__pills" role="tablist" aria-label="Workspaces">
      {workspaces.map((ws) => {
        const isActive = isHome ? ws.num === 1 : here === ws.name;
        const href = isHome ? `#ws-${ws.name}` : (ws.name === 'links' ? '/links' : `/#ws-${ws.name}`);
        return (
          <a
            href={href}
            class={`bar__pill ${isActive ? 'is-active' : ''}`}
            data-pill={ws.num}
            data-target={`ws-${ws.name}`}
            data-name={ws.name}
            aria-label={`${ws.num} ${ws.label}`}
            aria-selected={isActive ? 'true' : 'false'}
            role="tab"
          >
            <span class="bar__pill-pip"></span>
            <span class="bar__pill-label">{ws.num}</span>
          </a>
        );
      })}
    </div>
  </div>

  <div class="bar__center" aria-live="polite">
    <span class="bar__title-text">~ omega@cachyos: workspace {isHome ? '1 — home' : (here === 'links' ? '4 — links' : '404')}</span>
  </div>

  <div class="bar__right">
    <div class="bar__presence" data-presence data-discord-id={site.discordId}>
      <span class="bar__presence-dot" aria-hidden="true"></span>
      <span class="bar__presence-state" data-presence-state data-state="offline">checking…</span>
      <span class="bar__presence-activity visually-hidden" data-presence-activity>—</span>
    </div>

    <button class="bar__btn bar__launcher-btn" type="button" aria-label="Ctrl K launcher" data-launcher-trigger>
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
      <span class="bar__kbd-hint">Ctrl K</span>
    </button>

    <button class="bar__btn bar__keys-btn" type="button" aria-label="Show keybinds" data-keys-trigger>
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
    </button>

    <div class="bar__jukebox" id="bar-jukebox" style="display: none;">
      <button class="bar__jukebox-btn" type="button" aria-label="Jump to jukebox" data-jukebox-pill>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="bar__jukebox-icon">
          <path d="M9 18V5l12-2v13"/>
          <circle cx="6" cy="18" r="3"/>
          <circle cx="18" cy="16" r="3"/>
        </svg>
        <span class="bar__jukebox-title" data-jukebox-title>disc · omega</span>
      </button>
      <button class="bar__jukebox-stop" type="button" aria-label="Stop jukebox music" data-jukebox-stop>
        ■
      </button>
    </div>

    <div class="bar__clock" data-bar-clock>
      <span class="bar__date"></span>
      <span class="bar__time">--:--</span>
    </div>
  </div>
</nav>

<style>
  .bar {
    position: fixed;
    top: var(--gap-outer);
    left: var(--gap-outer);
    right: var(--gap-outer);
    height: 44px;
    z-index: 50;
    border-radius: var(--radius);
    background: rgb(22 22 22 / 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid var(--base02);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .bar {
      background: rgb(22 22 22 / 0.94);
    }
  }

  .bar__left {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .bar__badge {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    border-radius: 50%;
  }

  .bar__badge:focus-visible {
    border-radius: 50%;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .bar__pills {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .bar__pill {
    position: relative;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    text-decoration: none;
    padding: 0;
    color: var(--base00);
  }

  .bar__pill-pip {
    position: absolute;
    width: 28px;
    height: 18px;
    border-radius: 999px;
    background: var(--base03);
    transform: scale(calc(8 / 28), calc(8 / 18));
    transform-origin: center center;
    transition: transform var(--dur-2) var(--ease), background var(--dur-1) var(--ease);
    pointer-events: none;
  }

  .bar__pill.is-active .bar__pill-pip {
    background: var(--accent);
    transform: scale(1, 1);
  }

  .bar__pill-label {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--base00);
    opacity: 0;
    transition: opacity var(--dur-1) var(--ease);
  }

  .bar__pill.is-active .bar__pill-label {
    opacity: 1;
  }

  .bar__center {
    display: none;
  }

  @media (min-width: 900px) {
    .bar__center {
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      white-space: nowrap;
      font-size: 12px;
      color: var(--text-dim);
      padding-inline: 8px;
    }
  }

  .bar__title-text {
    transition: opacity 60ms ease;
  }
  .bar__title-text.fading {
    opacity: 0;
  }

  .bar__right {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
  }

  .bar__presence {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-inline: 6px;
    font-size: 12px;
    color: var(--text-dim);
    min-height: 44px;
  }

  .bar__presence-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--base03);
    transition: background var(--dur-1) var(--ease);
    flex-shrink: 0;
  }

  .bar__presence:has([data-state='online']) .bar__presence-dot {
    background: var(--green);
  }
  .bar__presence:has([data-state='idle']) .bar__presence-dot,
  .bar__presence:has([data-state='dnd']) .bar__presence-dot {
    background: var(--accent);
  }

  .bar__presence-state {
    font-size: 12px;
  }

  .bar__btn {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: transparent;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    border-radius: 6px;
    transition: color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .bar__btn:hover,
  .bar__btn:focus-visible {
    color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }

  .bar__kbd-hint {
    display: none;
  }

  @media (min-width: 640px) {
    .bar__launcher-btn {
      width: auto;
      padding-inline: 8px;
    }
    .bar__kbd-hint {
      display: inline-block;
      font-size: 10px;
      padding: 1px 4px;
      border-radius: 4px;
      background: var(--base01);
      border: 1px solid var(--base02);
      color: var(--text-dim);
    }
  }

  .bar__jukebox {
    display: inline-flex;
    align-items: center;
    background: var(--base01);
    border: 1px solid var(--base02);
    border-radius: 999px;
    height: 28px;
    padding: 2px 4px 2px 8px;
    gap: 6px;
    font-size: 11px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .bar__jukebox-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
  }

  .bar__jukebox-title {
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text);
  }

  .bar__jukebox-stop {
    background: transparent;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 10px;
    line-height: 1;
    padding: 2px 4px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .bar__jukebox-stop:hover,
  .bar__jukebox-stop:focus-visible {
    color: var(--accent);
    background: var(--base02);
  }

  .bar__clock {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-inline: 6px 8px;
    font-size: 12px;
    color: var(--text);
    white-space: nowrap;
    min-height: 44px;
  }

  .bar__date {
    display: none;
    color: var(--text-dim);
  }

  @media (min-width: 900px) {
    .bar__date {
      display: inline;
    }
  }

  @media (max-width: 639px) {
    .bar {
      height: 48px;
      left: 6px;
      right: 6px;
      padding-inline: 2px;
    }
    .bar__presence-state {
      display: none;
    }
    .bar__presence-activity {
      display: none;
    }
    .bar__presence {
      padding-inline: 4px;
      min-height: 48px;
    }
    .bar__keys-btn {
      display: none;
    }
    .bar__pill {
      margin-inline: -7px;
    }
    .bar__clock {
      padding-inline: 4px 6px;
    }
  }

  @media (max-width: 359px) {
    .bar {
      left: 4px;
      right: 4px;
      padding-inline: 1px;
    }
    .bar__pill {
      margin-inline: -9px;
    }
  }
</style>

<script>
  import { initPresence } from '../scripts/presence.js';

  initPresence();

  // Clock updates via setTimeout chain
  const clockRoot = document.querySelector('[data-bar-clock]');
  if (clockRoot) {
    const timeEl = clockRoot.querySelector('.bar__time');
    const dateEl = clockRoot.querySelector('.bar__date');

    const updateClock = () => {
      const now = new Date();
      const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
      const dateStr = now.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
      if (timeEl) timeEl.textContent = timeStr;
      if (dateEl) dateEl.textContent = dateStr;

      const msToNext = (60 - now.getSeconds()) * 1000 - now.getMilliseconds() + 50;
      setTimeout(updateClock, msToNext);
    };

    updateClock();
  }

  // Workspaces tracking and scroll spy
  const bar = document.getElementById('bar');
  const pills = bar ? Array.from(bar.querySelectorAll('.bar__pill')) : [];
  const titleText = bar ? bar.querySelector('.bar__title-text') : null;

  function setActivePill(num, name) {
    pills.forEach((p) => {
      const isMatch = p.getAttribute('data-pill') === String(num);
      p.classList.toggle('is-active', isMatch);
      p.setAttribute('aria-selected', isMatch ? 'true' : 'false');
    });

    if (titleText) {
      titleText.classList.add('fading');
      setTimeout(() => {
        titleText.textContent = `~ omega@cachyos: workspace ${num} — ${name}`;
        titleText.classList.remove('fading');
      }, 60);
    }
  }

  // IntersectionObserver for workspace tracking on homepage
  const sections = document.querySelectorAll('section[data-ws]');
  if (sections.length > 0 && 'IntersectionObserver' in window) {
    const wsObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const sec = entry.target;
            const id = sec.id || '';
            const match = id.match(/^ws-(.+)$/);
            if (match) {
              const name = match[1];
              const pill = pills.find((p) => p.getAttribute('data-name') === name);
              if (pill) {
                const num = pill.getAttribute('data-pill');
                setActivePill(num, name);
              }
            }
          }
        }
      },
      {
        rootMargin: '-35% 0px -35% 0px',
        threshold: 0.1,
      },
    );

    sections.forEach((sec) => wsObserver.observe(sec));
  }

  // Pill click smooth scrolling on homepage
  pills.forEach((pill) => {
    pill.addEventListener('click', (e) => {
      const targetId = pill.getAttribute('data-target');
      if (targetId && document.getElementById(targetId)) {
        e.preventDefault();
        const targetEl = document.getElementById(targetId);
        targetEl.scrollIntoView({ behavior: 'smooth' });
        history.replaceState(null, '', `#${targetId}`);
        const num = pill.getAttribute('data-pill');
        const name = pill.getAttribute('data-name');
        setActivePill(num, name);
      }
    });
  });

  // Triggers for launcher and keybinds
  const launcherBtn = bar ? bar.querySelector('[data-launcher-trigger]') : null;
  if (launcherBtn) {
    launcherBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('agemo:launcher'));
    });
  }

  const keysBtn = bar ? bar.querySelector('[data-keys-trigger]') : null;
  if (keysBtn) {
    keysBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('agemo:keys'));
    });
  }

  // Jukebox bar widget
  const jbRoot = document.getElementById('bar-jukebox');
  const jbTitle = jbRoot ? jbRoot.querySelector('[data-jukebox-title]') : null;
  const jbPill = jbRoot ? jbRoot.querySelector('[data-jukebox-pill]') : null;
  const jbStop = jbRoot ? jbRoot.querySelector('[data-jukebox-stop]') : null;

  window.addEventListener('agemo:jukebox-active', (e) => {
    if (!jbRoot) return;
    const track = e.detail?.track || 'omega';
    if (jbTitle) jbTitle.textContent = `disc · ${track}`;
    jbRoot.style.display = 'inline-flex';
  });

  window.addEventListener('agemo:jukebox-inactive', () => {
    if (!jbRoot) return;
    jbRoot.style.display = 'none';
  });

  if (jbPill) {
    jbPill.addEventListener('click', () => {
      const slot = document.querySelector('[data-demo="mc-jukebox"]');
      if (slot) {
        slot.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  if (jbStop) {
    jbStop.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('agemo:jukebox-stop'));
    });
  }
</script>
