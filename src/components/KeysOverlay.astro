---
// KeysOverlay.astro: Modal dialog showing interactive keybindings with keycaps
const bindings = [
  { key: '1 - 5', desc: 'jump to workspace 1 - 5' },
  { key: '/', desc: 'open launcher' },
  { key: 'Ctrl K', desc: 'open launcher' },
  { key: '?', desc: 'toggle keybinds overlay' },
  { key: 't', desc: 'focus terminal input' },
  { key: 'j / k', desc: 'next / previous workspace' },
  { key: 'Esc', desc: 'close dialogs & overlays' },
];
---
<div class="keys" id="keys-overlay" role="dialog" aria-modal="true" aria-label="Keybindings">
  <div class="keys__scrim" aria-hidden="true"></div>
  <div class="keys__card">
    <header class="keys__header">
      <h2 class="keys__title">Keybindings</h2>
      <button class="keys__close-btn" type="button" aria-label="Close keybindings">✕</button>
    </header>

    <div class="keys__body">
      <ul class="keys__list">
        {bindings.map((b) => (
          <li class="keys__item">
            <kbd class="keys__cap">{b.key}</kbd>
            <span class="keys__desc">{b.desc}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .keys {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 90;
    align-items: center;
    justify-content: center;
    padding: var(--gap-outer);
  }

  .keys.is-open {
    display: flex;
  }

  .keys__scrim {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.65);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .keys__scrim {
      background: rgb(22 22 22 / 0.95);
    }
  }

  .keys__card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 460px;
    background: var(--win-bg);
    border: 1px solid var(--base02);
    border-radius: var(--radius);
    padding: 24px;
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.7);
    animation: keysPop 180ms var(--ease-out) forwards;
  }

  @keyframes keysPop {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .keys__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .keys__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    color: var(--text);
    margin: 0;
  }

  .keys__close-btn {
    background: transparent;
    border: none;
    color: var(--text-dim);
    font-size: 16px;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
  }

  .keys__close-btn:hover,
  .keys__close-btn:focus-visible {
    color: var(--text);
    background: rgb(255 255 255 / 0.08);
  }

  .keys__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .keys__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .keys__cap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    background: var(--base01);
    border: 1px solid var(--accent);
    border-radius: 6px;
    color: var(--accent);
    font-family: inherit;
    font-weight: 700;
    font-size: 12px;
    min-height: 28px;
    box-shadow: 0 2px 0 var(--base02);
  }

  .keys__desc {
    color: var(--base04);
    text-align: right;
  }
</style>

<script>
  import { initKeys } from '../scripts/keys.js';
  initKeys();
</script>
