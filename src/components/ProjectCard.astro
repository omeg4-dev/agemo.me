---
const { repo } = Astro.props;
const dateStr = repo.pushedAt ? repo.pushedAt.slice(0, 7) : '';
---
<a
  class="repo-row"
  href={repo.url}
  target="_blank"
  rel="noopener noreferrer"
  data-project
  style={`--repo-accent: ${repo.accent};`}
>
  <span class="repo-row__bar" aria-hidden="true"></span>
  <h3 class="repo-row__name" data-project-name>{repo.name}</h3>
  <p class="repo-row__desc">{repo.description}</p>
  <div class="repo-row__meta">
    {repo.language && <span class="repo-row__lang" data-project-lang>{repo.language}</span>}
    <time class="repo-row__date" data-project-age datetime={repo.pushedAt}>{dateStr}</time>
  </div>
</a>

<style>
  .repo-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding-block: 1.75rem;
    padding-inline: 1.25rem 0.75rem;
    border-top: 1px solid var(--hairline);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease);
  }

  .repo-row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  @media (min-width: 900px) {
    .repo-row {
      grid-template-columns: 5fr 5fr 2fr;
      gap: 2rem;
      align-items: baseline;
    }
  }

  .repo-row__bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--repo-accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-2) var(--ease);
  }

  .repo-row:hover,
  .repo-row:focus-visible {
    background: var(--paper-2);
  }

  .repo-row:hover .repo-row__bar,
  .repo-row:focus-visible .repo-row__bar {
    transform: scaleY(1);
  }

  .repo-row__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 75%;
    font-size: clamp(1.6rem, 3.5vw, 2.75rem);
    line-height: 1.1;
    color: var(--ink);
    margin: 0;
    transition: transform var(--dur-2) var(--ease);
  }

  .repo-row:hover .repo-row__name,
  .repo-row:focus-visible .repo-row__name {
    transform: translateX(0.5rem);
  }

  .repo-row__desc {
    font-family: var(--font-body);
    color: var(--graphite);
    font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.05rem);
    line-height: 1.5;
    margin: 0;
  }

  .repo-row__meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--graphite);
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
  }

  @media (min-width: 900px) {
    .repo-row__meta {
      justify-content: flex-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .repo-row__bar,
    .repo-row__name {
      transition: none !important;
    }
  }
</style>
