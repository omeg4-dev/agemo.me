---
// Notifications.astro: Toast notification container
---
<div class="notifications-container" id="notifications-root" role="region" aria-label="Notifications" aria-live="polite"></div>

<style>
  .notifications-container {
    position: fixed;
    top: 56px;
    right: 20px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
    max-width: 340px;
    width: calc(100vw - 32px);
  }

  @media (max-width: 600px) {
    .notifications-container {
      top: 54px;
      right: 50%;
      transform: translateX(50%);
      align-items: center;
    }
  }

  :global(.toast) {
    pointer-events: auto;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    background: var(--base01);
    border: 1px solid var(--base02);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.5);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.4;
    animation: toast-in var(--dur-2) var(--ease-out) forwards;
    transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
    width: 100%;
    box-sizing: border-box;
  }

  :global(.toast--leaving) {
    opacity: 0;
    transform: translateX(30px);
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateX(40px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.toast) {
      animation: none !important;
      transform: none !important;
    }
    :global(.toast--leaving) {
      transform: none !important;
      opacity: 0;
    }
  }

  :global(.toast__icon) {
    font-size: 16px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  :global(.toast__content) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  :global(.toast__title) {
    font-weight: 700;
    font-size: 13px;
    color: var(--base05);
    font-family: var(--font-mono);
  }

  :global(.toast__body) {
    font-size: 12px;
    color: var(--base04);
  }

  :global(.toast__close) {
    background: transparent;
    border: none;
    color: var(--base04);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    padding: 0 4px;
    margin-left: auto;
    flex-shrink: 0;
    border-radius: 4px;
  }

  :global(.toast__close:hover),
  :global(.toast__close:focus-visible) {
    color: var(--base05);
    background: var(--base02);
  }
</style>

<script>
  import { initNotifications } from '../scripts/notify.js';
  initNotifications();
</script>
