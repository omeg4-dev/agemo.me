---
import Mirror from './Mirror.astro';
import site from '../config/site.mjs';
---
<section class="hero" data-hero>
  <div class="hero__content">
    <Mirror word="OMEGA" ariaLabel="Omega" variant="hero" />

    <div class="hero__details">
      <p class="hero__tagline identity__line">{site.tagline}</p>

      <div class="hero__mono">
        <span>omega</span>
        <svg class="hero__arrow" aria-hidden="true" focusable="false" viewBox="0 0 48 12">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 6h36M6 6l4.5-4M6 6l4.5 4M42 6l-4.5-4M42 6l-4.5 4"
          />
        </svg>
        <span>agemo</span>
      </div>
    </div>
  </div>

  <div class="hero__cue" aria-hidden="true">
    <span class="hero__cue-text">scroll</span>
    <span class="hero__cue-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(calc(100svh - 52px), 920px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(4rem, 10vh, 8rem) var(--gutter);
    background:
      radial-gradient(60% 50% at 30% 35%, color-mix(in srgb, white 45%, transparent), transparent),
      var(--paper);
    overflow: hidden;
  }

  @media (prefers-color-scheme: dark) {
    .hero {
      background:
        radial-gradient(60% 50% at 30% 35%, color-mix(in srgb, var(--signal) 8%, transparent), transparent),
        var(--paper);
    }
  }

  .hero__content {
    max-width: 1200px;
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__details {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: clamp(1.5rem, 4vh, 2.75rem);
    max-width: var(--measure);
    text-align: left;
  }

  .hero__tagline {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1rem + 0.6vw, 1.35rem);
    line-height: 1.5;
    color: var(--ink);
    margin: 0;
  }

  .hero__mono {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--graphite);
  }

  .hero__arrow {
    width: 2.2em;
    height: 0.65em;
    flex: none;
    color: var(--signal);
  }

  .hero__cue {
    position: absolute;
    bottom: clamp(1.5rem, 3vh, 2.5rem);
    left: var(--gutter);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
  }

  .hero__cue-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--graphite);
  }

  .hero__cue-line {
    width: 32px;
    height: 1px;
    background: var(--hairline);
  }

  @media (max-width: 600px) {
    .hero__cue {
      display: none;
    }
  }
</style>

<script>
  import { initMirrorLine } from '../scripts/mirror-line.js';
  initMirrorLine();
</script>
