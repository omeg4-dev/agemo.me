---
import Mirror from './Mirror.astro';
import site from '../config/site.mjs';
---
<section class="hero" data-hero>
  <div class="hero__wrap wrap">
    <div class="hero__content">
      <Mirror word="OMEGA" ariaLabel="Omega" variant="hero" />

      <p class="hero__tagline">{site.tagline}</p>

      <div class="hero__details">
        <div class="hero__mono">
          <span>omega</span>
          <svg class="hero__arrow" aria-hidden="true" focusable="false" viewBox="0 0 48 12">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 6h36M6 6l4.5-4M6 6l4.5 4M42 6l-4.5-4M42 6l-4.5 4"
            />
          </svg>
          <span>agemo</span>
        </div>

        <ul class="hero__chips" data-presence data-discord-id={site.discordId}>
          <li class="chip">
            <span class="chip__dot" aria-hidden="true"></span>
            <span data-presence-state data-state="offline">checking…</span>
          </li>
          <li class="chip"><span data-presence-activity>—</span></li>
          <li class="chip"><span data-clock>—</span></li>
        </ul>
      </div>
    </div>

    <div class="hero__cue" aria-hidden="true">
      <span class="hero__cue-text">scroll</span>
      <span class="hero__cue-line"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(60% 50% at 30% 35%, color-mix(in srgb, white 45%, transparent), transparent),
      var(--paper);
    overflow: hidden;
  }

  @media (prefers-color-scheme: dark) {
    .hero {
      background:
        radial-gradient(60% 50% at 30% 35%, color-mix(in srgb, var(--signal) 8%, transparent), transparent),
        var(--paper);
    }
  }

  .hero__wrap {
    position: relative;
    min-height: min(100svh, 56rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(4rem, 10vh, 8rem);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__tagline {
    margin: clamp(1.25rem, 3vh, 2rem) 0 0;
    max-width: var(--measure);
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1rem + 0.7vw, 1.5rem);
    line-height: 1.45;
    color: var(--ink);
  }

  .hero__details {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: clamp(1.5rem, 4vh, 2.75rem);
    max-width: var(--measure);
    text-align: left;
  }

  .hero__mono {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--graphite);
  }

  .hero__arrow {
    width: 2.2em;
    height: 0.65em;
    flex: none;
    color: var(--signal);
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.25rem;
    padding: 0 0.95rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--graphite);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .chip__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--graphite);
    transition: background var(--dur-1) var(--ease);
  }

  .chip:has([data-state='online']) .chip__dot {
    background: var(--signal);
  }

  .chip:has([data-state='idle']) .chip__dot,
  .chip:has([data-state='dnd']) .chip__dot {
    background: var(--signal);
    opacity: 0.8;
  }

  .hero__cue {
    position: absolute;
    bottom: clamp(1.5rem, 3vh, 2.5rem);
    left: var(--gutter);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
  }

  .hero__cue-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--graphite);
  }

  .hero__cue-line {
    width: 32px;
    height: 1px;
    background: var(--hairline);
  }

  @media (max-width: 600px) {
    .hero__cue {
      display: none;
    }
  }
</style>

<script>
  import { initMirrorLine } from '../scripts/mirror-line.js';
  import { initPresence } from '../scripts/presence.js';
  initMirrorLine();
  initPresence();
</script>
