---
import ProjectCard from './ProjectCard.astro';
import repos from '../data/repos.json';

const { pinned } = repos;
---
<section class="work" id="work" aria-labelledby="work-heading" data-reveal>
  <div class="work__rule" aria-hidden="true"></div>
  <header class="work__head">
    <p class="section-label">work</p>
    <h2 class="section-heading" id="work-heading">Work</h2>
  </header>

  <div class="work__list">
    {pinned.map((repo, i) => <ProjectCard repo={repo} index={i} />)}
  </div>
</section>

<style>
  .work {
    max-width: 1200px;
    margin-inline: auto;
    padding: clamp(5rem, 12vw, 10rem) var(--gutter) 0;
    display: grid;
    gap: clamp(2.5rem, 6vh, 4rem);
  }

  .work__rule {
    width: 100%;
    height: 1px;
    background: var(--hairline);
    margin-bottom: clamp(1rem, 3vh, 2rem);
  }

  .work__head {
    display: flex;
    flex-direction: column;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--graphite);
    margin: 0 0 0.5rem 0;
  }

  .section-heading {
    font-family: var(--font-display);
    font-stretch: 62%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.25rem, 7vw, 5.5rem);
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: var(--ink);
    margin: 0;
  }

  .work__list {
    display: grid;
  }
</style>
