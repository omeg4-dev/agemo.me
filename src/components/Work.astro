---
import ProjectCard from './ProjectCard.astro';
import repos from '../data/repos.json';

const { pinned } = repos;
const count = String(pinned.length).padStart(2, '0');
---
<section class="work" id="work" aria-labelledby="work-heading">
  <header class="work__head" data-reveal>
    <p class="work__eyebrow">{count} pinned · github/omeg4-dev</p>
    <h2 class="work__heading" id="work-heading">
      <span class="work__heading-ink">Work</span>
      <span class="work__heading-echo" aria-hidden="true">Work</span>
    </h2>
  </header>

  <div class="work__stack">
    {pinned.map((repo, i) => <ProjectCard repo={repo} index={i} />)}
  </div>
</section>

<style>
  .work {
    display: grid;
    gap: clamp(2rem, 6vh, 4rem);
    max-width: 1180px;
    margin-inline: auto;
    padding: clamp(3rem, 10vh, 7rem) var(--gutter);
  }

  .work__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--accent) 70%, var(--muted));
  }

  .work__heading {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(3rem, 12vw, 8rem);
    font-weight: 400;
    /* 1, not 0.9: a box shorter than its own glyphs puts `top: 100%` —
       where the reflection hangs — inside the letterforms. */
    line-height: 1;
    color: var(--text);
    /* Clearance for the reflection, which hangs a full line below the box and
       would otherwise be sliced off by the first slab. */
    margin-bottom: 0.55em;
  }

  /* The echo is the same word turned over beneath its own baseline — the
     waterline motif applied to a heading rather than to the hero mark. It is
     aria-hidden because the readable copy is .work__heading-ink above it. */
  .work__heading-echo {
    position: absolute;
    inset: 100% auto auto 0;
    /* No transform-origin. scaleY(-1) about `top` maps the box to [-h, 0] —
       it renders ABOVE its own top edge, i.e. straight back over the thing it
       is meant to reflect. The default 50% 50% origin flips in place, so the
       reflection stays in the box, and the box is placed below. */
    transform: scaleY(-1);
    color: color-mix(in oklab, var(--accent) 45%, transparent);
    -webkit-mask-image: linear-gradient(to top, transparent 15%, #000);
    mask-image: linear-gradient(to top, transparent 15%, #000);
    pointer-events: none;
    animation: heading-ripple 6.5s var(--ease) infinite alternate;
  }
  /* Only the reflection wobbles. The real word stays perfectly still, which
     is what makes the wobble read as water rather than as a shaky heading. */
  @keyframes heading-ripple {
    from { transform: scaleY(-1) skewX(0deg)  translateY(0); opacity: 0.75; }
    to   { transform: scaleY(-1) skewX(2.5deg) translateY(3px); opacity: 1; }
  }

  .work__stack {
    display: grid;
    gap: clamp(1.5rem, 5vh, 3.5rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .work__heading-echo { animation: none; }
  }
</style>

<script>
  import { initCards } from '../scripts/cards.js';
  initCards();
</script>
