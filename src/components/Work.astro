---
import site from '../config/site.mjs';
import data from '../data/repos.json' with { type: 'json' };
import { relativeAge } from '../../scripts/repos-transform.mjs';

const repos = data.pinned;
const built = new Date(data.generatedAt ?? Date.now());
---
<section class="section" id="pinned" aria-labelledby="pinned-title">
  <div class="head">
    <h2 id="pinned-title">Pinned</h2>
    <p class="mono">pinned on github</p>
  </div>
  <ul class="repos">
    {repos.map((r) => {
      const age = r.pushedAt ? `updated ${relativeAge(r.pushedAt, built)}` : '';
      return (
        <li class="repo">
          <a class="repo__link" href={r.url} rel="noopener">
            <span class="repo__name">{r.name}</span>
            <p class="repo__desc">{r.description}</p>
            <span class="repo__meta mono">
              {r.language && <span class="repo__lang">{r.language}</span>}
              {age && <span class="repo__age">{age}</span>}
              <span class="repo__arrow" aria-hidden="true">↗</span>
            </span>
            <span class="repo__sub mono">{[r.language, age].filter(Boolean).join(' · ')}</span>
          </a>
        </li>
      );
    })}
  </ul>
  <p class="more mono"><a href={site.links.github} rel="me noopener">everything else on github →</a></p>
</section>
