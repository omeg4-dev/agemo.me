---
// Machine.astro: Workspace 3 (Machine) - fastfetch system specs, palette, and keybinds
import Window from './Window.astro';
import site from '../config/site.mjs';

const logo = await import('./omega-logo.svg?raw').then((m) => m.default);

const keybindRows = [
  { key: '1 - 5', action: 'ws 1 - 5' },
  { key: '/', action: 'launcher' },
  { key: 'Ctrl K', action: 'launcher' },
  { key: '?', action: 'keybinds' },
  { key: 't', action: 'terminal' },
  { key: 'j / k', action: 'next / prev' },
  { key: 'Esc', action: 'close' },
];

const swatchAccentMap: Record<string, string> = {
  '#4cd9e7': 'cyan',
  '#e3b5ff': 'purple',
  '#78a9ff': 'blue',
  '#95e0a8': 'green',
  '#ffb4ab': 'rose',
  '#ee5396': 'pink',
};
---
<section class="machine" id="ws-machine" aria-labelledby="machine-heading" data-ws>
  <!-- Sprite containing symbols for fastfetch icons -->
  <svg class="machine__sprite" aria-hidden="true" focusable="false" width="0" height="0">
    <defs>
      <g id="ff-gear"><circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.4M12 18.6V21M3 12h2.4M18.6 12H21M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7"/></g>
      <g id="ff-terminal"><rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M7 10l2.6 2.4L7 14.8M12.4 15.2H17"/></g>
      <g id="ff-chip"><rect x="7" y="7" width="10" height="10" rx="1.6"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/></g>
      <g id="ff-palette"><path d="M12 3.5a8.5 8.5 0 100 17c1.4 0 2-.9 2-1.8 0-1.6-1.6-1.7-1.6-3 0-.9.8-1.6 1.9-1.6h1.4a4.8 4.8 0 004.8-4.8c0-3.4-3.8-5.8-8.5-5.8z"/><circle cx="8" cy="9.5" r="1.1"/><circle cx="12" cy="7.6" r="1.1"/><circle cx="16" cy="9.8" r="1.1"/></g>
      <g id="ff-user"><circle cx="12" cy="8.6" r="3.4"/><path d="M5.4 19.4a6.8 6.8 0 0113.2 0"/></g>
      <g id="ff-os"><path d="M12 2.8L20 20.6H4z"/><path d="M12 9.4l4.4 9.8h-8.8z"/></g>
      <g id="ff-kernel"><path d="M12 3.4c2.5 0 3.6 2 3.6 4.6 0 2 .6 2.6 1.9 4.6 1.3 2 2.4 3.4 2.4 5 0 1.7-1.6 2.6-3.3 2.6h-9.2c-1.7 0-3.3-.9-3.3-2.6 0-1.6 1.1-3 2.4-5 1.3-2 1.9-2.6 1.9-4.6 0-2.6 1.1-4.6 3.6-4.6z"/><circle cx="10.3" cy="8.2" r=".9"/><circle cx="13.7" cy="8.2" r=".9"/></g>
      <g id="ff-shell"><path d="M4 6.5l5.5 5.5L4 17.5M12.5 17.5H20"/></g>
      <g id="ff-wm"><rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M3 9.5h18M11 9.5v10"/></g>
      <g id="ff-bar"><rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M3 9h18"/><circle cx="6.3" cy="6.7" r=".85"/><circle cx="9.1" cy="6.7" r=".85"/></g>
      <g id="ff-display"><rect x="2.6" y="4.6" width="18.8" height="12" rx="2"/><path d="M9 20h6M12 16.6V20"/></g>
      <g id="ff-cpu"><rect x="6.5" y="6.5" width="11" height="11" rx="1.6"/><rect x="10" y="10" width="4" height="4" rx=".8"/><path d="M9.5 2.8v3.7M14.5 2.8v3.7M9.5 17.5v3.7M14.5 17.5v3.7M2.8 9.5h3.7M2.8 14.5h3.7M17.5 9.5h3.7M17.5 14.5h3.7"/></g>
      <g id="ff-gpu"><rect x="2.6" y="6.5" width="18.8" height="11" rx="2"/><circle cx="9" cy="12" r="2.8"/><path d="M15 9.6h3.6M15 14.4h3.6M6.5 17.5v3.2M17 17.5v3.2"/></g>
      <g id="ff-ram"><rect x="2.6" y="7.5" width="18.8" height="9" rx="1.6"/><path d="M6.4 16.5v3M17.6 16.5v3M9 10.6v3M12 10.6v3M15 10.6v3"/></g>
      <g id="ff-disk"><ellipse cx="12" cy="6.4" rx="8" ry="3"/><path d="M4 6.4v11.2c0 1.7 3.6 3 8 3s8-1.3 8-3V6.4"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></g>
      <g id="ff-vol"><rect x="2.8" y="4.6" width="18.4" height="6" rx="1.6"/><rect x="2.8" y="13.4" width="18.4" height="6" rx="1.6"/><path d="M6.4 7.6h.02M6.4 16.4h.02"/></g>
      <g id="ff-fs"><ellipse cx="12" cy="6" rx="7.6" ry="2.9"/><path d="M4.4 6v5.6c0 1.6 3.4 2.9 7.6 2.9s7.6-1.3 7.6-2.9V6"/><path d="M4.4 12.4V18c0 1.6 3.4 2.9 7.6 2.9s7.6-1.3 7.6-2.9v-5.6"/></g>
      <g id="ff-lang"><path d="M8.6 7.4L3.8 12l4.8 4.6M15.4 7.4L20.2 12l-4.8 4.6M13.6 4.6l-3.2 14.8"/></g>
      <g id="ff-editor"><path d="M3.6 16.8L14.9 5.5a2.2 2.2 0 013.2 0l.4.4a2.2 2.2 0 010 3.2L7.2 20.4l-4.4 1.2z"/><path d="M13.3 7.1l3.6 3.6"/></g>
    </defs>
  </svg>

  <header class="machine__head">
    <h2 class="section-heading" id="machine-heading">machine</h2>
    <p class="section-sub">system specifications & desktop setup</p>
  </header>

  <div class="machine__layout" id="machine">
    <!-- Main fastfetch window -->
    <Window title="fastfetch" app="kitty" class="machine__win-ff" i={0}>
      <div class="ff">
        <div class="ff__logo" set:html={logo} />

        <div class="ff__panel" data-uses>
          {site.machine.map((section) => (
            <section class="ff__block" style={`--c: ${section.colour}`}>
              <h3 class="ff__title">
                <svg class="ff__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href={`#ff-${section.icon}`} /></svg>
                <span>{section.name}</span>
                <span class="ff__rule" aria-hidden="true"></span>
              </h3>

              <dl class="ff__rows">
                {section.rows.map((row) => (
                  <div class="ff__row">
                    <dt>
                      <svg class="ff__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href={`#ff-${row.icon}`} /></svg>
                      <span>{row.k}</span>
                    </dt>
                    <dd>{row.v}</dd>
                  </div>
                ))}
              </dl>

              <div class="ff__close" aria-hidden="true"></div>
            </section>
          ))}

          <ul class="ff__swatches" aria-hidden="true">
            {site.swatches.map((c, i) => <li style={`--s: ${c}; --i: ${i}`}></li>)}
          </ul>
        </div>
      </div>

      <p class="machine__steal">
        <a href={site.links.github} target="_blank" rel="noopener noreferrer">all of it on github →</a>
      </p>
    </Window>

    <!-- Right stack: Palette & Keybinds -->
    <div class="machine__right-col">
      <!-- Palette Window -->
      <Window title="palette" app="noctalia" class="machine__win-palette" i={1}>
        <div class="palette">
          <p class="palette__label">accent</p>
          <div class="palette__swatches">
            {site.swatches.map((hex) => {
              const accName = swatchAccentMap[hex] || (hex === '#3a4348' ? 'blue' : (hex === '#dde4e4' ? 'cyan' : ''));
              const isAccentCapable = Boolean(swatchAccentMap[hex]);
              return (
                <div class="palette__item">
                  <button
                    class={`palette__btn ${isAccentCapable ? 'is-interactive' : ''}`}
                    type="button"
                    style={`--btn-c: ${hex};`}
                    data-accent-btn={isAccentCapable ? swatchAccentMap[hex] : undefined}
                    aria-label={isAccentCapable ? `accent: ${swatchAccentMap[hex]}` : `swatch ${hex}`}
                    aria-pressed="false"
                  >
                    <span class="palette__circle"></span>
                  </button>
                  <span class="palette__hex">{hex}</span>
                </div>
              );
            })}
          </div>
        </div>
      </Window>

      <!-- Keybinds Window -->
      <Window title="keybinds" app="hypr-keybind-overlay" class="machine__win-keys" i={2}>
        <div class="keybinds-panel" role="list">
          {keybindRows.map((r) => (
            <div class="keybinds-panel__row" role="listitem">
              <span class="keybinds-panel__key-slot">
                <kbd class="keybinds-panel__key">{r.key}</kbd>
              </span>
              <span class="keybinds-panel__action">{r.action}</span>
            </div>
          ))}
        </div>
      </Window>
    </div>
  </div>
</section>

<style>
  .machine {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    content-visibility: auto;
    contain-intrinsic-size: 1000px;
  }

  .machine__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-left: 0;
  }

  .section-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 62%;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--blue);
    background: linear-gradient(135deg, var(--blue) 0%, var(--purple) 50%, var(--pink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0;
  }

  @supports not (background-clip: text) {
    .section-heading {
      background: none;
      -webkit-text-fill-color: initial;
      color: var(--blue);
    }
  }

  .section-sub {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .machine__layout {
    display: grid;
    gap: var(--gap-inner);
    width: 100%;
  }

  @media (min-width: 1100px) {
    .machine__layout {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .machine__right-col {
    display: flex;
    flex-direction: column;
    gap: var(--gap-inner);
  }

  /* fastfetch styles inside window */
  .machine__sprite { position: absolute; }

  .ff__icon {
    width: 1em;
    height: 1em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ff {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    grid-template-columns: 1fr;
    color: var(--screen-text);
  }

  @media (min-width: 800px) {
    .ff {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    }
  }

  .ff__logo {
    display: flex;
    justify-content: center;
  }

  .ff__logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: min(100%, 18rem);
    opacity: 0.9;
  }

  .ff__panel {
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.15vw, 0.78rem);
    line-height: 1.75;
    min-width: 0;
  }

  .ff__block { --c: var(--signal); }
  .ff__block + .ff__block { margin-top: 0.9rem; }

  /* ╭─ icon NAME ───────── */
  .ff__title {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    padding-left: 1.5em;
    font-size: inherit;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c);
  }

  .ff__title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.9em;
    height: 0.9em;
    border-left: 1px solid var(--c);
    border-top: 1px solid var(--c);
    border-top-left-radius: 5px;
  }

  .ff__rule {
    flex: 1;
    height: 1px;
    min-width: 1.5rem;
    background: linear-gradient(90deg, var(--c), color-mix(in srgb, var(--c) 8%, transparent));
  }

  /* The │ gutter */
  .ff__rows {
    margin: 0;
    padding-left: 0.9em;
    border-left: 1px solid color-mix(in srgb, var(--c) 42%, transparent);
  }

  .ff__row {
    display: grid;
    grid-template-columns: minmax(6.5em, auto) 1fr;
    gap: 0.4em 1em;
    align-items: baseline;
  }

  .ff__row dt {
    display: flex;
    align-items: center;
    gap: 0.55em;
    color: var(--c);
  }

  .ff__row dd {
    margin: 0;
    color: var(--base04);
    overflow-wrap: anywhere;
  }

  /* ╰──────────── */
  .ff__close {
    display: flex;
    align-items: flex-end;
  }

  .ff__close::before {
    content: '';
    width: 0.9em;
    height: 0.9em;
    flex: none;
    border-left: 1px solid var(--c);
    border-bottom: 1px solid var(--c);
    border-bottom-left-radius: 5px;
  }

  .ff__close::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--c), color-mix(in srgb, var(--c) 5%, transparent));
  }

  .ff__swatches {
    display: flex;
    gap: 0.55em;
    list-style: none;
    margin: 1rem 0 0;
    padding-left: 1.2em;
  }

  .ff__swatches li {
    width: 0.72em;
    height: 0.72em;
    border-radius: 50%;
    background: var(--s);
    opacity: 0.9;
  }

  .machine__steal {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    margin-top: 14px;
  }

  .machine__steal a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    min-width: 48px;
    box-sizing: border-box;
    flex-shrink: 0;
    color: var(--text-dim);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease);
  }

  .machine__steal a:hover,
  .machine__steal a:focus-visible {
    color: var(--text);
  }

  /* Palette window styles */
  .palette {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .palette__label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-dim);
    margin: 0;
  }

  .palette__swatches {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  @media (max-width: 500px) {
    .palette__swatches {
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }
  }

  .palette__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .palette__btn {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    box-sizing: border-box;
    flex-shrink: 0;
    border-radius: 50%;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: default;
  }

  .palette__btn.is-interactive {
    cursor: pointer;
  }

  .palette__circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--btn-c);
    border: 2px solid var(--base02);
    transition: transform var(--dur-1) var(--ease), box-shadow var(--dur-1) var(--ease);
  }

  .palette__btn:hover .palette__circle,
  .palette__btn:focus-visible .palette__circle {
    transform: scale(1.15);
    box-shadow: 0 0 14px var(--btn-c);
  }

  .palette__btn[aria-pressed='true'] .palette__circle {
    border-color: #fff;
    box-shadow: 0 0 16px var(--btn-c);
    transform: scale(1.1);
  }

  .palette__hex {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
  }

  /* Keybinds panel styles */
  .keybinds-panel {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .keybinds-panel__row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 6px 0;
    border-bottom: 1px solid var(--base02);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .keybinds-panel__row:last-child {
    border-bottom: none;
  }

  .keybinds-panel__key-slot {
    width: 64px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
  }

  .keybinds-panel__key {
    padding: 3px 8px;
    background: var(--base00);
    border: 1px solid var(--base02);
    border-radius: 4px;
    color: var(--accent);
    font-family: inherit;
    font-weight: 700;
  }

  .keybinds-panel__action {
    color: var(--base04);
  }
</style>

<script>
  import { setAccent, getAccent } from '../scripts/accent.js';

  // Palette button interactions
  const pBtns = document.querySelectorAll('[data-accent-btn]');
  const currentAcc = getAccent();
  pBtns.forEach((b) => {
    if (b.getAttribute('data-accent-btn') === currentAcc) {
      b.setAttribute('aria-pressed', 'true');
    }

    b.addEventListener('click', () => {
      const acc = b.getAttribute('data-accent-btn');
      if (acc) setAccent(acc);
    });
  });
</script>
