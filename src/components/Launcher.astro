---
// Launcher.astro: Noctalia/rofi-style command palette dialog
---
<div class="launcher" id="launcher-modal" role="dialog" aria-modal="true" aria-label="Command palette">
  <div class="launcher__scrim" aria-hidden="true"></div>
  <div class="launcher__panel">
    <div class="launcher__search-row">
      <svg class="launcher__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
      <input
        class="launcher__input"
        type="text"
        aria-label="Search"
        placeholder="jump to…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
    </div>

    <ul class="launcher__list" role="listbox" aria-label="Command suggestions"></ul>
    <div class="launcher__empty" style="display: none;"></div>
  </div>
</div>

<style>
  .launcher {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 95;
    align-items: flex-start;
    justify-content: center;
    padding-top: 18vh;
    padding-inline: var(--gap-outer);
  }

  .launcher.is-open {
    display: flex;
  }

  .launcher__scrim {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .launcher__scrim {
      background: rgb(22 22 22 / 0.95);
    }
  }

  .launcher__panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 560px;
    background: var(--win-bg);
    border-radius: var(--radius);
    border: var(--border) solid transparent;
    background:
      linear-gradient(var(--win-bg-solid, #1a1a1a), var(--win-bg-solid, #1a1a1a)) padding-box,
      linear-gradient(45deg, var(--accent), var(--accent-2)) border-box;
    box-shadow: 0 25px 70px rgb(0 0 0 / 0.7);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: launcherSlide 160ms var(--ease-out) forwards;
  }

  @keyframes launcherSlide {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .launcher__search-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--base02);
  }

  .launcher__icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  .launcher__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--text);
  }

  .launcher__list {
    list-style: none;
    margin: 0;
    padding: 8px 0;
    max-height: 380px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  :global(.launcher__item) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding: 10px 18px;
    cursor: pointer;
    font-family: var(--font-mono);
    transition: background-color var(--dur-1) var(--ease);
  }

  :global(.launcher__item.is-active),
  :global(.launcher__item:hover) {
    background: rgb(255 255 255 / 0.08);
  }

  :global(.launcher__item-title) {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
  }

  :global(.launcher__mark) {
    background: transparent;
    color: var(--accent);
    text-decoration: underline;
    font-weight: 900;
  }

  :global(.launcher__item-sub) {
    font-size: 12px;
    color: var(--text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.launcher__item-badge) {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--base02);
    color: var(--base04);
    align-self: center;
  }

  .launcher__empty {
    padding: 24px 18px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .launcher {
      padding-top: calc(48px + var(--gap-outer));
    }
  }
</style>

<script>
  let launcherPromise = null;
  function getLauncher() {
    if (!launcherPromise) {
      launcherPromise = import('../scripts/launcher.js').then((m) => {
        m.initLauncher();
        return m;
      });
    }
    return launcherPromise;
  }

  // Open triggers
  window.addEventListener('agemo:launcher', () => {
    const prev = document.activeElement;
    getLauncher().then((m) => {
      m.openLauncher(prev);
    });
  });

  const triggerBtn = document.querySelector('[data-launcher-trigger]');
  if (triggerBtn) {
    triggerBtn.addEventListener('click', () => {
      getLauncher().then((m) => {
        m.openLauncher(triggerBtn);
      });
    });
  }

  // Lazy-load on idle or fallback timeout
  if (typeof window !== 'undefined') {
    const preload = () => getLauncher();
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(preload);
    } else {
      setTimeout(preload, 1000);
    }
  }
</script>
