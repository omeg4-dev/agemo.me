---
// Shell for the project pages under agemo.me/<name>/. Each page brings its
// own look, so this carries only what every page needs: meta, icons, fonts
// to preload, and a way back.
interface Props {
  title: string;
  description: string;
  theme: string;
  fonts?: string[];
  bodyClass: string;
}
const { title, description, theme, fonts = [], bodyClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {fonts.map((f) => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
